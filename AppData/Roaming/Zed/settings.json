// Zed settings //
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //tab width
  "proxy": "",
  "title_bar": {
    "show_sign_in": false
  },
  "which_key": {
    "enabled": true
  },
  "icon_theme": "Catppuccin Mocha",
  "auto_update": false,
  "session": {
    "trust_all_worktrees": true
  },
  "preview_tabs": {
    "enabled": false
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "mouse_wheel_zoom": true,
  "gutter": {
    "line_numbers": true,
    "folds": false
  },
  "minimap": {
    "show": "never"
  },
  "hover_popover_enabled": true,
  "selection_highlight": false,
  "buffer_font_fallbacks": [
    "Josefin Sans"
  ],
  "colorize_brackets": false,
  "show_edit_predictions": true,
  "preferred_line_length": 60,
  // CHANGED: was "editor_width". VSCode's "editor.wordWrapColumn": 60 wraps
  // at a fixed column regardless of pane width — "editor_width" doesn't do
  // that, it wraps to whatever width the pane happens to be. This setting
  // is what actually gives you the fixed-60-column wrap you had before.
  "soft_wrap": "none",
  "hard_tabs": true,
  "tab_size": 4,
  "base_keymap": "VSCode",
  "ui_font_family": "Iosevka Nerd Font",
  "tabs": {
    // "file_icons": true,
    "git_status": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  //terminal
  "terminal": {
    "font_fallbacks": [
      "monospace",
      "monospace"
    ],
    "font_family": "Iosevka Nerd Font",
    "font_size": 21.0,
    "copy_on_select": true,
    "default_width": 187,
    "line_height": {
      "custom": 1.0
    },
    "shell": "system"
  },
  //code formatter
  "format_on_save": "on",
  "formatter": {
    "language_server": {
      "name": "prettier"
    }
  },
  // ADDED: ported from your VSCode prettier.* extension settings
  "prettier": {
    "semi": true,
    "useTabs": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "arrowParens": "avoid",
    "trailingComma": "all"
  },
  // ADDED: "formatter" above is global, which would otherwise route Rust
  // files through Prettier (Prettier can't format Rust). This keeps Rust
  // on its own language server (rust-analyzer -> rustfmt), which is what
  // your commented-out "rust-analyzer" default-formatter line in VSCode
  // was already pointing at.
  "languages": {
    "Rust": {
      "formatter": "language_server"
    }
  },
  //toolbar
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "autosave_delay": 1500,
  "autosave_on_focus_change": true,
  "autosave_on_window_change": true,
  "autosave_on_build": true,
  "autosave_on_build_delay": 1500,
  "autosave_on_build_events": [
    "build",
    "run",
    "debug"
  ],
  "autosave_on_build_events_delay": 1500,
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "vim_mode": true,
  "ui_font_size": 19.0,
  "buffer_font_size": 17.0,
  "buffer_font_features": {
    "liga": true
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Catppuccin Mocha - No Italics"
  },
  "relative_line_numbers": "enabled",
  "buffer_font_family": "JetBrainsMono NF",
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    },
    "show": "never"
  },
  // Indentation, rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    // CHANGED: was "true". VSCode had "editor.inlayHints.enabled": "off"
    // (flagged "remember changed" in your settings), so this now matches.
    "enabled": false
  },
  // ADDED: ported from VSCode's "editor.scrollBeyondLastLine": false
  "scroll_beyond_last_line": "off",
  // File scan exclusions, hide on the file explorer and search
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
    // ADDED: ported from VSCode's files.exclude
    "**/*.class",
    "**/*.exe",
    "**/*.pdb"
  ],
  // Turn off telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // Move all panel to the right
  "project_panel": {
    "auto_fold_dirs": false,
    "button": true,
    "dock": "right",
    "git_status": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  // Move some unnecessary panels to the left
  "notification_panel": {
    "dock": "left"
  },
  "chat_panel": {
    "dock": "left"
  },
  "cursor_blink": false,
  "multi_cursor_modifier": "alt",
  "cursor_shape": "bar",
// "context": "Workspace",
//  "bindings": {
//    "ctrl-;": null,
//    "alt-e": "workspace::ToggleRightDock",
//    "alt-d": "workspace::CloseAllDocks",
//    "space t h": "theme_selector::Toggle",
//    "alt-q": ["task::Spawn", { "task_name": "run file" }],
//    "alt-w": "workspace::CloseWindow",
//    "ctrl-j": null
//  }
}
