// Zed settings
// Docs: https://zed.dev/docs/configuring-zed
{
    // ─────────────────────────────────────────────────────────────────────────────
    // 1. TYPOGRAPHY & FONTS (All Fonts in One Place)
    // ─────────────────────────────────────────────────────────────────────────────
    // Editor (Buffer) Font
    // "buffer_font_family": "CozetteVector",
    "buffer_font_family": "Departure Mono",
    "buffer_font_fallbacks": [
        "Iosevka Nerd Font Mono",
        "Aporetic Sans Mono",
        "FantasqueSansM Nerd Font Mono"
    ],
    "buffer_font_size": 32.0, // <- Change this to adjust editor code size
    "buffer_font_weight": 400, // Regular = 400, Medium = 500, SemiBold = 600, Bold = 700
    "buffer_line_height": {
        "custom": 1.4 // Line height spacing (1.35 - 1.4 sweet spot)
    },
    "buffer_font_features": {
        "liga": true, // Enable standard ligatures
        "calt": true // Contextual alternates (coding ligatures: ->, =>, !=, ===)
    },
    // UI Font (Sidebars, Menus, Status Bar, Tabs)
    "ui_font_family": "Iosevka Nerd Font Mono",
    "ui_font_fallbacks": [
        "Segoe UI",
        "system-ui"
    ],
    "ui_font_size": 19.0,
    "ui_font_weight": 400,
    // Terminal Font
    "terminal": {
        "shell": {
            "program": "pwsh.exe"
        },
        "font_family": "Iosevka Nerd Font",
        "font_fallbacks": [
            "monospace"
        ],
        "font_size": 22.0,
        "line_height": {
            "custom": 1.0
        },
        "copy_on_select": true,
        "default_width": 187
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 2. THEME & ICONS
    // ─────────────────────────────────────────────────────────────────────────────
    "icon_theme": "JetBrains Icons Dark",
    "theme": {
        "mode": "system",
        "light": "Gruvbox Light",
        "dark": "Base16 Gruvbox Material Dark, Medium"
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 3. GENERAL & WINDOW
    // ─────────────────────────────────────────────────────────────────────────────
    "cli_default_open_behavior": "existing_window",
    "instrumentation": {
        "performance_profiler": {
            "enabled": false
        }
    },
    "show_wrap_guides": true,
    "auto_update": false,
    "base_keymap": "VSCode",
    "when_closing_with_no_tabs": "keep_window_open",
    "bottom_dock_layout": "contained",
    "session": {
        "trust_all_worktrees": true
    },
    "horizontal_scroll_margin": 1,
    "vertical_scroll_margin": 99,
    // ─────────────────────────────────────────────────────────────────────────────
    // 4. EDITOR BEHAVIOUR
    // ─────────────────────────────────────────────────────────────────────────────
    "preferred_line_length": 60,
    "soft_wrap": "editor_width",
    "hard_tabs": false,
    "tab_size": 4,
    "colorize_brackets": false,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "show_edit_predictions": true,
    "show_signature_help_after_edits": false,
    "auto_signature_help": true,
    "mouse_wheel_zoom": true,
    "hover_popover_enabled": true,
    "inline_code_actions": false,
    "selection_highlight": false,
    "scroll_beyond_last_line": "vertical_scroll_margin",
    "cursor_blink": false,
    "cursor_shape": "bar",
    "multi_cursor_modifier": "alt",
    // ─────────────────────────────────────────────────────────────────────────────
    // 5. GUTTER & LINE NUMBERS
    // ─────────────────────────────────────────────────────────────────────────────
    "gutter": {
        "line_numbers": true,
        "folds": false,
        "code_actions": false,
        "runnables": false,
        "breakpoints": false,
        "bookmarks": false,
        "min_line_number_digits": 0
    },
    "relative_line_numbers": "enabled",
    // ─────────────────────────────────────────────────────────────────────────────
    // 6. MINIMAP & SCROLLBAR
    // ─────────────────────────────────────────────────────────────────────────────
    "minimap": {
        "show": "never"
    },
    "scrollbar": {
        "show": "never",
        "axes": {
            "horizontal": false,
            "vertical": false
        }
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 7. INDENT GUIDES & INLAY HINTS
    // ─────────────────────────────────────────────────────────────────────────────
    "indent_guides": {
        "enabled": true,
        "coloring": "fixed"
    },
    "inlay_hints": {
        "enabled": false
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 8. TABS, TOOLBAR & STATUS BAR
    // ─────────────────────────────────────────────────────────────────────────────
    "preview_tabs": {
        "enabled": false
    },
    "tabs": {
        "git_status": true
    },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false
    },
    "status_bar": {
        "experimental.show": false,
        "active_language_button": false,
        "cursor_position_button": false,
        "line_endings_button": false
    },
    "centered_layout": {
        "left_padding": 0.15,
        "right_padding": 0.15
    },
    "title_bar": {
        "show_sign_in": false,
        "show_project_items": false,
        "show_branch_name": false,
        "show_user_menu": false,
        "show_worktree_name": false,
        "show_branch_status_icon": false
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 9. GIT (VERSION CONTROL)
    // ─────────────────────────────────────────────────────────────────────────────
    "git": {
        "git_gutter": "hide",
        "inline_blame": {
            "enabled": false
        }
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 10. VIM MODE & WHICH-KEY
    // ─────────────────────────────────────────────────────────────────────────────
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always"
    },
    "which_key": {
        "enabled": true
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 11. AUTOSAVE
    // ─────────────────────────────────────────────────────────────────────────────
    "autosave": {
        "after_delay": {
            "milliseconds": 500
        }
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 12. CODE FORMATTER
    // ─────────────────────────────────────────────────────────────────────────────
    "format_on_save": "on",
    "remove_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    "formatter": "language_server",
    // ─────────────────────────────────────────────────────────────────────────────
    // 13. PER-LANGUAGE OVERRIDES
    // ─────────────────────────────────────────────────────────────────────────────
    "languages": {
        "Rust": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "Python": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "Go": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "C": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "C++": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "Lua": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "JavaScript": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "TypeScript": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "TSX": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "JSON": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "HTML": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "CSS": {
            "formatter": "language_server",
            "tab_size": 4,
            "hard_tabs": true
        },
        "Java": {
            "formatter": "language_server",
            "tab_size": 2,
            "hard_tabs": false
        }
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 14. LSP (LANGUAGE SERVER PROTOCOL) CONFIG
    // ─────────────────────────────────────────────────────────────────────────────
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy"
                }
            }
        },
        "lua-language-server": {
            "settings": {
                "Lua": {
                    "diagnostics": {
                        "globals": [
                            "vim"
                        ]
                    }
                }
            }
        },
        "gopls": {
            "initialization_options": {
                "analyses": {
                    "unusedparams": true
                },
                "staticcheck": true
            }
        }
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 15. AI MODELS (GOOGLE GEMINI 3.7 FLASH)
    // ─────────────────────────────────────────────────────────────────────────────
    "language_models": {
        "google": {
            "available_models": [
                {
                    "name": "gemini-3.7-flash",
                    "display_name": "Gemini 3.7 Flash",
                    "max_tokens": 1000000
                },
                {
                    "name": "gemini-2.5-pro",
                    "display_name": "Gemini 2.5 Pro",
                    "max_tokens": 1000000
                }
            ]
        }
    },
    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "google",
            "model": "gemini-3.7-flash"
        },
        "inline_assistant_model": {
            "provider": "google",
            "model": "gemini-3.7-flash"
        },
        "favorite_models": []
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 16. PANEL DOCK LAYOUT
    // ─────────────────────────────────────────────────────────────────────────────
    "project_panel": {
        "auto_fold_dirs": false,
        "button": true,
        "dock": "right",
        "git_status": true,
        "hide_root": true,
        "scrollbar": {
            "show": "never"
        },
        "indent_guides": {
            "show": "never"
        }
    },
    "outline_panel": {
        "dock": "right",
        "scrollbar": {
            "show": "never"
        },
        "indent_guides": {
            "show": "never"
        }
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left"
    },
    "notification_panel": {
        "dock": "left"
    },
    "chat_panel": {
        "dock": "left"
    },
    // ─────────────────────────────────────────────────────────────────────────────
    // 17. FILE SCAN EXCLUSIONS
    // ─────────────────────────────────────────────────────────────────────────────
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/out",
        "**/dist",
        "**/.husky",
        "**/.turbo",
        "**/.vscode-test",
        "**/.vscode",
        "**/.next",
        "**/.storybook",
        "**/.tap",
        "**/.nyc_output",
        "**/report",
        "**/node_modules",
        "**/*.class",
        "**/*.exe",
        "**/*.pdb"
    ],
    // ─────────────────────────────────────────────────────────────────────────────
    // 18. TELEMETRY
    // ─────────────────────────────────────────────────────────────────────────────
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
