// Zed settings //
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  "proxy": "",
  "title_bar": {
    "show_sign_in": false
  },
  "which_key": {
    "enabled": true
  },
  "icon_theme": "Catppuccin Mocha",
  "auto_update": false,
  "session": {
    "trust_all_worktrees": true
  },
  "preview_tabs": {
    "enabled": false
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "mouse_wheel_zoom": true,
  "gutter": {
    "line_numbers": true,
    "folds": false
  },
  "minimap": {
    "show": "never"
  },
  "hover_popover_enabled": true,
  "selection_highlight": false,
  "ui_font_family": "Iosevka Nerd Font",
  "ui_font_size": 19.0,
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_fallbacks": [
    "JetBrainsMono NF",
    "Josefin Sans"
  ],
  "buffer_font_size": 19.0,
  "buffer_font_features": {
    "liga": true
  },
  "colorize_brackets": false,
  "show_edit_predictions": true,
  "preferred_line_length": 60,
  "soft_wrap": "none",
  "hard_tabs": true,
  "tab_size": 4,
  "base_keymap": "VSCode",
  "tabs": {
    "git_status": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  // Terminal
  "terminal": {
    "font_fallbacks": [
      "monospace"
    ],
    "font_family": "Iosevka Nerd Font",
    "font_size": 19.0,
    "copy_on_select": true,
    "default_width": 187,
    "line_height": {
      "custom": 1.0
    },
    "shell": {
      "program": "pwsh.exe"
    }
  },
  // Code formatter
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "formatter": {
    "language_server": {
      "name": "prettier"
    }
  },
  // Ported from VSCode prettier.* settings
  "prettier": {
    "semi": true,
    "useTabs": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "arrowParens": "avoid",
    "trailingComma": "all"
  },
  "languages": {
    "Rust": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "Python": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "Go": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "C": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "C++": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "Lua": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "JavaScript": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "TypeScript": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "TSX": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "JSON": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "HTML": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    },
    "CSS": {
      "formatter": "language_server",
      "tab_size": 4,
      "hard_tabs": true
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "lua-language-server": {
      "settings": {
        "Lua": {
          "diagnostics": {
            "globals": ["vim"]
          }
        }
      }
    },
    "gopls": {
      "initialization_options": {
        "analyses": {
          "unusedparams": true
        },
        "staticcheck": true
      }
    }
  },
  // Toolbar
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "autosave_delay": 1500,
  "autosave_on_focus_change": true,
  "autosave_on_window_change": true,
  "autosave_on_build": true,
  "autosave_on_build_delay": 1500,
  "autosave_on_build_events": [
    "build",
    "run",
    "debug"
  ],
  "autosave_on_build_events_delay": 1500,
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Catppuccin Mocha - No Italics"
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    },
    "show": "never"
  },
  // Indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": false
  },
  "scroll_beyond_last_line": "off",
  // File scan exclusions
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
    "**/*.class",
    "**/*.exe",
    "**/*.pdb"
  ],
  // Telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // Panels dock layout
  "project_panel": {
    "auto_fold_dirs": false,
    "button": true,
    "dock": "right",
    "git_status": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "notification_panel": {
    "dock": "left"
  },
  "chat_panel": {
    "dock": "left"
  },
  "cursor_blink": false,
  "multi_cursor_modifier": "alt",
  "cursor_shape": "bar"
}
