[
  // =============================================================================
  //                           Global / Workspace Keybindings
  // =============================================================================
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-shift-;": "workspace::NewTerminal",
      "alt-e": "project_panel::ToggleFocus",
      "alt-l": "workspace::ToggleLeftDock",
      "alt-p": "command_palette::Toggle",
      "alt-f": "file_finder::Toggle",
      "alt-o": "workspace::Open",
      "alt-shift-x": "zed::Extensions",
      "alt-w": "pane::CloseActiveItem",
      "ctrl-k ctrl-s": "zed::OpenKeymap",
      "ctrl-,": "zed::OpenSettings",
      "alt-r": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],
      "shift-alt-g": "git_panel::ToggleFocus",
      "alt-{": "vim::ResizePaneLeft",
      "alt-}": "vim::ResizePaneRight",
      "ctrl-alt-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "ctrl-alt-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" }
      ],
      "ctrl-alt-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" }
      ],
      "ctrl-alt-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ]
    }
  },

  // =============================================================================
  //                           Workspace || Terminal
  // =============================================================================
  {
    "context": "Workspace || Terminal",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "alt-w": "pane::CloseActiveItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem"
    }
  },

  // =============================================================================
  //                           General Editor Keybindings
  // =============================================================================
  {
    "context": "Editor",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "alt-shift-y": "zed::DecreaseBufferFontSize",
      "alt-shift-u": "zed::IncreaseBufferFontSize",
      "alt-y": "editor::Copy",
      "alt-u": "editor::Paste",
      "ctrl-alt-f": "editor::Fold",
      "ctrl-alt-u": "editor::UnfoldLines",
      "ctrl-/": "editor::ToggleComments",
      "alt-l": "workspace::ToggleLeftDock",
      "ctrl-enter": "assistant::InlineAssist",
      "alt-i": "editor::ShowCompletions"
    }
  },

  // =============================================================================
  //                   Editor (Normal & Visual Modes - Vim)
  // =============================================================================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "space t h": "theme_selector::Toggle",
      "space i a": "assistant::InlineAssist",
      "alt-l": "workspace::ToggleLeftDock",
      "alt-e": "project_panel::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space g q": "workspace::ToggleRightDock",
      "space o r": "projects::OpenRecent",
      "space x": "zed::Extensions",
      "space o k": "zed::OpenKeymap",
      "space o s": "zed::OpenSettingsFile",
      "space o g": "zed::OpenSettings",
      "space n f": "workspace::NewFile",
      "space t t": "workspace::NewTerminal",
      "alt-v": "pane::SplitVertical",
      "alt-h": "pane::SplitHorizontal",
      "space g v": "pane::SplitVertical",
      "space g h": "pane::SplitHorizontal",
      "space z z": "workspace::ToggleCenteredLayout",
      "space z f": "zed::ToggleFullScreen",
      "f11": "zed::ToggleFullScreen",
      "space r f": "editor::ToggleFoldRecursive",
      "z a": "editor::ToggleFold",
      "space h r": "editor::RevertSelectedHunks",
      "space h d": "editor::ToggleHunkDiff",
      "space h p": "editor::ToggleHunkDiff",
      "space g h d": "editor::ToggleHunkDiff",
      "space g h r": "editor::RevertSelectedHunks",
      "space l g": "git_panel::ToggleFocus",
      "space b": "editor::ToggleBreakpoint",
      "space i h": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      "space m p": "markdown::OpenPreview",
      "space m v": "markdown::OpenPreviewToTheSide",
      "space f g": "pane::DeploySearch",
      "space f f": "file_finder::Toggle",
      "space o f": "workspace::Open",
      "space o e": "editor::RevealInFileManager",
      "space c p": "editor::CopyPath",
      "space c n": "editor::CopyRelativePath",
      "space f d": "editor::Format",
      "space /": "editor::ToggleComments",
      "space c s": "outline::Toggle",
      "g f": "editor::OpenExcerpts"
    }
  },

  // =============================================================================
  //                   Editor (Normal Mode Only - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "space w": "workspace::Save",
      "space W": "workspace::SaveWithoutFormat",
      "ctrl-s": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "space c t": "pane::CloseInactiveItems",
      "space c l": "pane::CloseItemsToTheLeft",
      "space n f": "workspace::NewFile",
      "space f n": "workspace::NewFile",
      "space n n": "editor::NewlineBelow",
      "space n k": "editor::NewlineAbove",
      "space enter": "editor::NewlineBelow",
      "space s a": "editor::SelectAll",
      "space y a": [
        "editor::SelectAll",
        "editor::Copy"
      ],
      "+": "vim::Increment",
      "-": "vim::Decrement",
      "ctrl-a": "vim::Increment",
      "ctrl-x": "vim::Decrement",
      "g p": [
        "editor::NewlineBelow",
        "editor::Paste"
      ],
      "p": "editor::Paste",
      "U": "vim::Redo",
      "shift-l": "editor::Hover",
      "shift-j": "pane::ActivateNextItem",
      "shift-k": "pane::ActivatePreviousItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "space c a": "editor::ToggleCodeActions",
      "space r v": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "g i": "editor::GoToImplementation",
      "g I": "editor::GoToImplementationSplit",
      "g t": "editor::GoToTypeDefinition",
      "g T": "editor::GoToTypeDefinitionSplit",
      "g r": "editor::FindAllReferences",
      "space r f": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "space v p": "diagnostics::Deploy",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "s": "vim::HelixJumpToWord",
      "S": "vim::HelixJumpToWord",
      "space j": "vim::JoinLines",
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward"
    }
  },

  // =============================================================================
  //                   Empty Pane
  // =============================================================================
  {
    "context": "EmptyPane",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "space o r": "projects::OpenRecent"
    }
  },

  // =============================================================================
  //                   Editor (Visual Mode - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "g c": "editor::ToggleComments",
      "space /": "editor::ToggleComments",
      "x": "editor::Delete",
      "p": "editor::Paste",
      "space c a": "editor::ToggleCodeActions",
      "space r v": "editor::Rename",
      "s": "vim::HelixJumpToWord",
      "S": "vim::PushAddSurrounds",
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "<": "editor::Outdent",
      ">": "editor::Indent"
    }
  },

  // =============================================================================
  //                   Editor (Operator-Pending Mode - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == operator",
    "bindings": {
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      "z": "vim::PushSneak",
      "Z": "vim::PushSneakBackward"
    }
  },

  // =============================================================================
  //                   Editor (Insert Mode - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "j k": "vim::NormalBefore",
      "alt-i": "editor::ShowCompletions",
      "alt-l": "workspace::ToggleLeftDock",
      "ctrl-p": "editor::Paste"
    }
  },

  // =============================================================================
  //                   Terminal
  // =============================================================================
  {
    "context": "Terminal && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-shift-;": "workspace::NewTerminal",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem"
    }
  },

  // =============================================================================
  //                   Project Panel (File Tree)
  // =============================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "f2": "project_panel::Rename",
      "d": "project_panel::Delete",
      "delete": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "c p": "project_panel::CopyPath",
      "c n": "project_panel::CopyRelativePath",
      "y y": "project_panel::CopyPath",
      "y f": "project_panel::Duplicate",
      "l": "project_panel::OpenPermanent",
      "enter": "project_panel::OpenPermanent",
      "right": "project_panel::OpenPermanent",
      "h": "project_panel::CollapseSelectedEntry",
      "left": "project_panel::CollapseSelectedEntry",
      "j": "menu::SelectNext",
      "down": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "up": "menu::SelectPrevious",
      "z a": "project_panel::CollapseAllEntries",
      "o e": "project_panel::RevealInFileManager",
      "escape": "project_panel::ToggleFocus",
      "q": "project_panel::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "alt-e": "project_panel::ToggleFocus",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // =============================================================================
  //                   Dock Navigation
  // =============================================================================
  {
    "context": "Dock",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown"
    }
  },

  // =============================================================================
  //                   Run Nearest Task
  // =============================================================================
  {
    "context": "EmptyPane || vim_mode == normal",
    "bindings": {
      "space r t": [
        "editor::SpawnNearestTask",
        {
          "reveal": "no_focus"
        }
      ]
    }
  },

  // =============================================================================
  //                   VimControl Keybindings
  // =============================================================================
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      "g i": "editor::ToggleCodeActions",
      "g d": "editor::OpenExcerpts"
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "g l": "vim::SelectNext",
      "g L": "vim::SelectPrevious",
      "g a": "editor::SelectAllMatches",
      "g A": "editor::FindAllReferences",
      "g f": "project_symbols::Toggle",
      "space p e": "diagnostics::Deploy"
    }
  },

  // =============================================================================
  //                   Assistant / AI Window Keybindings
  // =============================================================================
  {
    "context": "AgentPanel || AssistantPanel",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "alt-l": "workspace::ToggleLeftDock",
      "alt-w": "pane::CloseActiveItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  }
]
