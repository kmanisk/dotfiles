[
  // =============================================================================
  //                           Global / Workspace Keybindings
  // =============================================================================
  {
    "context": "Workspace",
    "bindings": {
      // Toggle / Hide Bottom Dock (Terminal, Diagnostics, Task output, etc.)
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "ctrl-shift-;": "workspace::NewTerminal",
      "cmd-b": "workspace::ToggleRightDock",

      // Sidebar / Explorer toggles
      "alt-e": "workspace::ToggleRightDock",
      "alt-s": "multi_workspace::ToggleWorkspaceSidebar",

      // Command Palette & Quick Access
      "alt-p": "command_palette::Toggle",
      "alt-f": "file_finder::Toggle",
      "alt-o": "workspace::Open",
      "alt-shift-t": "agent::ToggleSearch",
      "alt-shift-x": "zed::Extensions",

      // Window & Item Closing
      "alt-w": "pane::CloseActiveItem",

      // Themes & Settings
      "ctrl-s ctrl-k": "zed::OpenKeymap",

      // Tasks (Code Runner)
      "alt-r": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],
      "alt-t": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],

      // AI Assistant / Panel (Toggle Left Dock with alt-l)
      "alt-l": "workspace::ToggleLeftDock",

      // Git Panel
      "shift-alt-g": "git_panel::ToggleFocus",

      // Pane Resizing (matches VSCode shift+alt+[ and shift+alt+])
      "shift-alt-[": "vim::ResizePaneLeft",
      "shift-alt-]": "vim::ResizePaneRight",

      // Move current editor to pane in direction (matches VSCode ctrl+alt+h/j/k/l)
      "ctrl-alt-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "ctrl-alt-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" }
      ],
      "ctrl-alt-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" }
      ],
      "ctrl-alt-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ]
    }
  },

  // =============================================================================
  //                           Workspace || Terminal
  // =============================================================================
  {
    "context": "Workspace || Terminal",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "alt-w": "pane::CloseActiveItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem"
    }
  },

  // =============================================================================
  //                           General Editor Keybindings
  // =============================================================================
  {
    "context": "Editor",
    "bindings": {
      // Toggle / Hide Bottom Dock (overrides default line number toggle)
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",

      // Font Zoom (matches VSCode alt+shift+y / alt+shift+u)
      "alt-shift-y": "zed::DecreaseBufferFontSize",
      "alt-shift-u": "zed::IncreaseBufferFontSize",

      // Clipboard (matches VSCode alt+y / alt+u)
      "alt-y": "editor::Copy",
      "alt-u": "editor::Paste",

      // Code Folding (matches VSCode ctrl+alt+f / ctrl+alt+u)
      "ctrl-alt-f": "editor::Fold",
      "ctrl-alt-u": "editor::UnfoldLines",

      // Toggle Comments (matches VSCode ctrl+/)
      "ctrl-/": "editor::ToggleComments",

      // AI Assistant (Toggle Left Dock with alt-l)
      "alt-l": "workspace::ToggleLeftDock",
      "alt-s": "multi_workspace::ToggleWorkspaceSidebar",

      // Inline AI Assistant (generate / edit code in-place)
      "ctrl-enter": "assistant::InlineAssist"
    }
  },

  // =============================================================================
  //                   Editor (Normal & Visual Modes - Vim)
  // =============================================================================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",

      // Themes & AI
      "space t h": "theme_selector::Toggle",
      "space i a": "assistant::InlineAssist",

      // Sidebar & Navigation
      "alt-l": "workspace::ToggleLeftDock",
      "alt-s": "multi_workspace::ToggleWorkspaceSidebar",
      "space a s": "multi_workspace::ToggleWorkspaceSidebar",
      "space a i": "workspace::ToggleLeftDock",
      "space e": "workspace::ToggleRightDock",
      "space s": "workspace::ToggleRightDock",
      "space g q": "workspace::ToggleRightDock",
      "space o r": "projects::OpenRecent",
      "space f p": "projects::OpenRecent",
      "space f h": "projects::OpenRecent",
      "space p o": "projects::OpenRecent",
      "space p a": "projects::OpenRecent",
      "space x": "zed::Extensions",
      "space s k": "zed::OpenKeymap",
      "space o k": "zed::OpenKeymap",
      "space o c": "zed::OpenSettings",
      "space o s": "zed::OpenSettings",
      "space n f": "workspace::NewFile",
      "space t t": "workspace::NewTerminal",

      // Splits
      "alt-v": "pane::SplitVertical",
      "alt-h": "pane::SplitHorizontal",
      "space g v": "pane::SplitVertical",
      "space g h": "pane::SplitHorizontal",

      // Zoom & Zen Mode (matches Neovim / VSCode zen-mode)
      "space z z": "workspace::ToggleCenteredLayout",
      "space z f": "workspace::ToggleZoom",

      // Folds
      "space r f": "editor::ToggleFoldRecursive",
      "z a": "editor::ToggleFold",

      // Git & Panels
      "space g h d": "editor::ToggleHunkDiff",
      "space g h r": "editor::RevertSelectedHunks",
      "space l g": "git_panel::ToggleFocus",

      // Breakpoints & Debug
      "space b": "editor::ToggleBreakpoint",

      // Inlay Hints & Wrap
      "space t i": "editor::ToggleInlayHints",
      "space i h": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",

      // Previews
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      "space l p": "markdown::OpenPreview",

      // Search & Files
      "space s w": "pane::DeploySearch",
      "space f g": "pane::DeploySearch",
      "space s f": "pane::DeploySearch",
      "space p f": "pane::DeploySearch",
      "space f f": "file_finder::Toggle",
      "space o f": "workspace::Open",
      "space o e": "editor::RevealInFileManager",
      "space o w": "workspace::ToggleBottomDock",

      // Format & Comment
      "space f d": "editor::Format",
      "space /": "editor::ToggleComments",

      // Outline / Buffer Symbols Toggle
      "space c s": "outline::Toggle",
      "ctrl-shift-o": "outline::Toggle",

      // Go to excerpts
      "g f": "editor::OpenExcerpts"
    }
  },

  // =============================================================================
  //                   Editor (Normal Mode Only - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",

      // Save & Close
      "space w": "workspace::Save",
      "space W": "workspace::SaveWithoutFormat",
      "ctrl-s": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "space c t": "pane::CloseInactiveItems",
      "space c l": "pane::CloseItemsToTheLeft",
      "space n": "editor::NewlineBelow",
      "space N": "editor::NewlineAbove",

      // Selection & Clipboard
      "space s a": "editor::SelectAll",
      "space d a": [
        "editor::SelectAll",
        "editor::Cut"
      ],
      "space y a": [
        "editor::SelectAll",
        "editor::Copy"
      ],
      "space d": [
        "editor::SelectAll",
        "editor::Copy"
      ],

      // Number Increment & Decrement (matches Neovim +/-)
      "+": "vim::Increment",
      "-": "vim::Decrement",
      "=": "vim::Increment",
      "ctrl-a": "vim::Increment",
      "ctrl-x": "vim::Decrement",

      // Paste on new line (matches Neovim gp / gP)
      "g p": [
        "editor::NewlineBelow",
        "vim::Paste"
      ],
      "g P": [
        "editor::NewlineAbove",
        "vim::Paste"
      ],

      // Redo with U
      "U": "vim::Redo",

      // Hover
      "shift-l": "editor::Hover",

      // Tab / Item switching
      "shift-j": "pane::ActivateNextItem",
      "shift-k": "pane::ActivatePreviousItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem",

      // Window / Pane navigation (matches Neovim / VSCode ctrl-h/j/k/l)
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      // LSP / Code Actions
      "space c a": "editor::ToggleCodeActions",
      "space a": "editor::ToggleCodeActions",
      "space .": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinitionSplit",
      "g i": "editor::GoToImplementation",
      "space g i": "editor::GoToImplementation",
      "g I": "editor::GoToImplementationSplit",
      "g t": "editor::GoToTypeDefinition",
      "g T": "editor::GoToTypeDefinitionSplit",
      "g r": "editor::FindAllReferences",
      "space g r": "editor::FindAllReferences",

      // Code Runner Mappings
      "space r r": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],
      "space r f": [
        "task::Spawn",
        {
          "task_name": "run file"
        }
      ],

      // Diagnostics / Problems
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": "editor::GoToDiagnostic",
      "[ e": "editor::GoToPreviousDiagnostic",
      "space x x": "diagnostics::Deploy",
      "space v p": "diagnostics::Deploy",

      // Symbol Search & Outline
      "space c s": "outline::Toggle",

      // Git Navigation
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",

      // Project Panel Reveal
      "space e": "pane::RevealInProjectPanel",

      // Leap & Motion Jumps
      "g w": "vim::HelixJumpToWord",
      "space j": "vim::HelixJumpToWord",
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      "g z z": "editor::ScrollCursorCenter"
    }
  },

  // =============================================================================
  //                   Empty Pane / Shared Screen
  // =============================================================================
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "space f p": "projects::OpenRecent"
    }
  },

  // =============================================================================
  //                   Editor (Visual Mode - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "g c": "editor::ToggleComments",
      "space /": "editor::ToggleComments",
      "x": "editor::Cut",
      "space a": "editor::ToggleCodeActions",
      "space c a": "editor::ToggleCodeActions",
      "space f d": "editor::Format",
      "shift-s": ["vim::PushAddSurrounds", {}],
      "s": ["vim::PushAddSurrounds", {}],
      "g w": "vim::HelixJumpToWord",
      "space j": "vim::HelixJumpToWord",
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",

      // Move selected lines up/down (matches Neovim J / K in visual mode)
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",

      // Indent & Outdent
      "<": "editor::Outdent",
      ">": "editor::Indent"
    }
  },

  // =============================================================================
  //                   Editor (Insert Mode - Vim)
  // =============================================================================
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      // Escape to Normal Mode with jk
      "j k": "vim::NormalBefore",
      "alt-i": "editor::ShowCompletions",
      "alt-l": "workspace::ToggleLeftDock",
      "ctrl-p": "editor::Paste",
      "ctrl-m": "editor::Paste"
    }
  },

  // =============================================================================
  //                   Terminal
  // =============================================================================
  {
    "context": "Terminal && !menu",
    "bindings": {
      // Close / Hide bottom dock from inside terminal
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "ctrl-shift-;": "workspace::NewTerminal",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem"
    }
  },

  // =============================================================================
  //                   Project Panel (File Tree)
  // =============================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "l": "project_panel::Open",
      "z a": "project_panel::CollapseAllEntries",
      "o e": "project_panel::RevealInFileManager",
      "y y": "project_panel::CopyPath",
      "y f": "project_panel::Duplicate",
      "q": "workspace::ToggleRightDock",
      "space e": "workspace::ToggleRightDock",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // =============================================================================
  //                   Dock Navigation
  // =============================================================================
  {
    "context": "Dock",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown"
    }
  },

  // =============================================================================
  //                   Run Nearest Task
  // =============================================================================
  {
    "context": "EmptyPane || SharedScreen || vim_mode == normal",
    "bindings": {
      "space r t": [
        "editor::SpawnNearestTask",
        {
          "reveal": "no_focus"
        }
      ]
    }
  },

  // =============================================================================
  //                   VimControl Keybindings
  // =============================================================================
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      "g w": "vim::HelixJumpToWord",
      "g i": "editor::ToggleCodeActions",
      "g d": "editor::OpenExcerpts",
      "g c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "g l": "vim::SelectNext",
      "g L": "vim::SelectPrevious",
      "g a": "editor::SelectAllMatches",
      "g shift-a": "editor::FindAllReferences",
      "g f": "project_symbols::Toggle",
      "g w": "vim::HelixJumpToWord",
      "space j": "vim::HelixJumpToWord",
      "space p e": "diagnostics::Deploy"
    }
  },

  // =============================================================================
  //                   Assistant / AI Window Keybindings
  // =============================================================================
  {
    "context": "AssistantPanel || AgentPanel || ContextEditor",
    "bindings": {
      "ctrl-;": "workspace::ToggleBottomDock",
      "ctrl-`": "workspace::ToggleBottomDock",
      "alt-shift-t": "agent::ToggleSearch",
      "escape": "agent::DismissThreadSearch",
      "alt-s": "multi_workspace::ToggleWorkspaceSidebar",
      "alt-l": "workspace::ToggleLeftDock",
      "space a i": "workspace::ToggleLeftDock",
      "alt-w": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "space q": "pane::CloseActiveItem",
      "alt-j": "pane::ActivateNextItem",
      "alt-k": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  }
]
