{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# common.txt hash: {{ include "packages/common.txt" | sha256sum }}
# linux-core.txt hash: {{ include "packages/linux-core.txt" | sha256sum }}
# hyprland.txt hash: {{ include "packages/hyprland.txt" | sha256sum }}
# gaming.txt hash: {{ include "packages/gaming.txt" | sha256sum }}
# nvidia.txt hash: {{ include "packages/nvidia.txt" | sha256sum }}
# asus.txt hash: {{ include "packages/asus.txt" | sha256sum }}
# audio.txt hash: {{ include "packages/audio.txt" | sha256sum }}
# development.txt hash: {{ include "packages/development.txt" | sha256sum }}
# aur-explicit.txt hash: {{ include "packages/aur-explicit.txt" | sha256sum }}

{{ $machineKey := "asus-tuf-f16" -}}
{{ if hasKey . "machine" }}{{ $machineKey = .machine }}{{ end -}}
{{ $m := index .machines $machineKey -}}
{{ if not $m }}{{ $m = index .machines "generic-linux" }}{{ end -}}

set -euo pipefail

echo "=========================================="
echo "==> Chezmoi: Reconciling system packages"
echo "==> Target Machine: {{ $machineKey }}"
echo "=========================================="

# 1. Snapshot safety check (User rule: snapshot before system changes)
if command -v snapper >/dev/null 2>&1 && sudo snapper list-configs 2>/dev/null | grep -qw root; then
    echo "Creating pre-package-sync Snapper snapshot..."
    sudo snapper -c root create -d "chezmoi package reconciliation" -t pre || echo "Notice: Snapper snapshot skipped or failed."
fi

# 2. Resolve package manager command array safely without word splitting
declare -a PKG_INSTALL_CMD
declare -a AUR_INSTALL_CMD

PREF_PM="{{ $m.providers.package_manager }}"

if [ "$PREF_PM" = "paru" ] && command -v paru >/dev/null 2>&1; then
    PKG_INSTALL_CMD=(paru -S --needed --noconfirm)
    AUR_INSTALL_CMD=(paru -S --needed --noconfirm)
elif [ "$PREF_PM" = "yay" ] && command -v yay >/dev/null 2>&1; then
    PKG_INSTALL_CMD=(yay -S --needed --noconfirm)
    AUR_INSTALL_CMD=(yay -S --needed --noconfirm)
elif command -v paru >/dev/null 2>&1; then
    PKG_INSTALL_CMD=(paru -S --needed --noconfirm)
    AUR_INSTALL_CMD=(paru -S --needed --noconfirm)
elif command -v yay >/dev/null 2>&1; then
    PKG_INSTALL_CMD=(yay -S --needed --noconfirm)
    AUR_INSTALL_CMD=(yay -S --needed --noconfirm)
else
    PKG_INSTALL_CMD=(sudo pacman -S --needed --noconfirm)
    AUR_INSTALL_CMD=()
fi

# 3. Assemble declarative package sets based on machine features
LISTS=()
LISTS+=("{{ .chezmoi.sourceDir }}/packages/common.txt")
LISTS+=("{{ .chezmoi.sourceDir }}/packages/linux-core.txt")

{{ if $m.features.hyprland -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/hyprland.txt")
{{ end -}}

{{ if $m.features.gaming -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/gaming.txt")
{{ end -}}

{{ if eq $m.hardware.gpu_strategy "hybrid-optimus-d3cold" -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/nvidia.txt")
{{ end -}}

{{ if $m.features.asus_ctl -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/asus.txt")
{{ end -}}

{{ if hasPrefix "pipewire" $m.providers.audio -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/audio.txt")
{{ end -}}

{{ if $m.features.development -}}
LISTS+=("{{ .chezmoi.sourceDir }}/packages/development.txt")
{{ end }}

declare -a PKGS=()
for file in "${LISTS[@]}"; do
    if [ -f "$file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            # Trim whitespace
            trimmed=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -n "$trimmed" ] && [[ ! "$trimmed" =~ ^# ]]; then
                PKGS+=("$trimmed")
            fi
        done < "$file"
    fi
done

if [ ${#PKGS[@]} -gt 0 ]; then
    echo "==> Reconciling ${#PKGS[@]} declarative packages using: ${PKG_INSTALL_CMD[0]}"
    "${PKG_INSTALL_CMD[@]}" "${PKGS[@]}"
fi

# 4. Reconcile explicit AUR packages
AUR_LIST="{{ .chezmoi.sourceDir }}/packages/aur-explicit.txt"
declare -a AUR_PKGS=()
if [ -f "$AUR_LIST" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        trimmed=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        if [ -n "$trimmed" ] && [[ ! "$trimmed" =~ ^# ]]; then
            AUR_PKGS+=("$trimmed")
        fi
    done < "$AUR_LIST"
fi

if [ ${#AUR_PKGS[@]} -gt 0 ]; then
    if [ ${#AUR_INSTALL_CMD[@]} -gt 0 ]; then
        echo "==> Reconciling ${#AUR_PKGS[@]} AUR packages using: ${AUR_INSTALL_CMD[0]}"
        "${AUR_INSTALL_CMD[@]}" "${AUR_PKGS[@]}"
    else
        echo "WARNING: No AUR helper found. Cannot automatically install AUR packages: ${AUR_PKGS[*]}"
    fi
fi

echo "==> Declarative package reconciliation complete."
{{ end }}
