{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Machine Profile & Feature Hash: {{ index .machines (default "asus-tuf-f16" .machine) | toJson | sha256sum }}

{{ $machineKey := "asus-tuf-f16" -}}
{{ if hasKey . "machine" }}{{ $machineKey = .machine }}{{ end -}}
{{ $m := index .machines $machineKey -}}
{{ if not $m }}{{ $m = index .machines "generic-linux" }}{{ end -}}

set -euo pipefail

echo "=============================================================================="
echo "==> Chezmoi: Reconciling System Services & Providers"
echo "==> Target Machine: {{ $machineKey }}"
echo "=============================================================================="

# 1. Login & Greeter Provider Reconciliation
LOGIN_MODE="{{ $m.providers.login_mode }}"
GREETER="{{ $m.providers.greeter }}"

if [ "$LOGIN_MODE" = "getty-tty1-autologin" ]; then
    echo "--> [Login Provider] Reconciling: getty-tty1-autologin (Headless)..."
    # Disable Ly if enabled to avoid TTY conflicts
    if systemctl is-enabled ly.service >/dev/null 2>&1; then
        echo "    Disabling ly.service (headless autologin selected)..."
        sudo systemctl disable --now ly.service 2>/dev/null || true
    fi
    # Ensure systemd getty override exists
    if [ ! -f /etc/systemd/system/getty@tty1.service.d/override.conf ]; then
        echo "    Configuring /etc/systemd/system/getty@tty1.service.d/override.conf..."
        sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
        sudo tee /etc/systemd/system/getty@tty1.service.d/override.conf >/dev/null << 'GETTY_OVERRIDE_EOF'
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin {{ .chezmoi.username }} --noclear %I $TERM
GETTY_OVERRIDE_EOF
        sudo systemctl daemon-reload
        sudo systemctl restart getty@tty1.service || true
    fi
elif [ "$GREETER" = "ly" ]; then
    echo "--> [Login Provider] Reconciling: Ly Display Manager..."
    if [ -f /etc/systemd/system/getty@tty1.service.d/override.conf ]; then
        echo "    Retiring getty autologin override..."
        sudo rm -f /etc/systemd/system/getty@tty1.service.d/override.conf
        sudo systemctl daemon-reload
    fi
    if ! systemctl is-enabled ly.service >/dev/null 2>&1; then
        echo "    Enabling ly.service..."
        sudo systemctl enable --now ly.service 2>/dev/null || true
    fi
fi

# 2. Core System Services
echo "--> [Core Services] Ensuring fstrim and scheduler daemon..."
for core_svc in "ananicy-cpp.service" "fstrim.timer"; do
    if systemctl list-unit-files "$core_svc" &>/dev/null; then
        if ! systemctl is-active --quiet "$core_svc"; then
            echo "    Enabling $core_svc..."
            sudo systemctl enable --now "$core_svc" 2>/dev/null || true
        fi
    fi
done

# 3. Bluetooth Service Reconciliation
{{ if $m.features.bluetooth }}
echo "--> [Bluetooth] Feature enabled..."
if systemctl list-unit-files "bluetooth.service" &>/dev/null; then
    if ! systemctl is-active --quiet "bluetooth.service"; then
        echo "    Enabling bluetooth.service..."
        sudo systemctl enable --now "bluetooth.service" 2>/dev/null || true
    fi
fi
{{ else }}
echo "--> [Bluetooth] Feature disabled..."
if systemctl is-active --quiet "bluetooth.service" 2>/dev/null; then
    echo "    Retiring bluetooth.service..."
    sudo systemctl disable --now "bluetooth.service" 2>/dev/null || true
fi
{{ end }}

# 4. ASUS Hardware Management Reconciliation
{{ if $m.features.asus_ctl }}
echo "--> [ASUS WMI] Feature enabled..."
for asus_svc in "asusd.service" "supergfxd.service"; do
    if systemctl list-unit-files "$asus_svc" &>/dev/null; then
        if ! systemctl is-active --quiet "$asus_svc"; then
            echo "    Enabling $asus_svc..."
            sudo systemctl enable --now "$asus_svc" 2>/dev/null || true
        fi
    fi
done
if command -v asusctl >/dev/null 2>&1; then
    asusctl battery limit 60 2>/dev/null || true
    asusctl profile set Balanced 2>/dev/null || true
fi
{{ else }}
echo "--> [ASUS WMI] Feature disabled..."
for asus_svc in "asusd.service" "supergfxd.service"; do
    if systemctl is-active --quiet "$asus_svc" 2>/dev/null; then
        echo "    Retiring $asus_svc..."
        sudo systemctl disable --now "$asus_svc" 2>/dev/null || true
    fi
done
{{ end }}

# 5. Snapper Cleanup Timer Reconciliation
{{ if $m.features.snapper }}
echo "--> [Snapper] Feature enabled..."
if systemctl list-unit-files "snapper-cleanup.timer" &>/dev/null; then
    if ! systemctl is-active --quiet "snapper-cleanup.timer"; then
        echo "    Enabling snapper-cleanup.timer..."
        sudo systemctl enable --now "snapper-cleanup.timer" 2>/dev/null || true
    fi
fi
{{ else }}
echo "--> [Snapper] Feature disabled..."
if systemctl is-active --quiet "snapper-cleanup.timer" 2>/dev/null; then
    echo "    Retiring snapper-cleanup.timer..."
    sudo systemctl disable --now "snapper-cleanup.timer" 2>/dev/null || true
fi
{{ end }}

# 6. User Services: XRemap Reconciliation
{{ if eq $m.providers.xremap "user-service" }}
echo "--> [XRemap] Provider active: user-service..."
if systemctl --user list-unit-files "xremap.service" &>/dev/null; then
    if ! systemctl --user is-active --quiet "xremap.service"; then
        echo "    Enabling user xremap.service..."
        systemctl --user enable --now "xremap.service" 2>/dev/null || true
    fi
fi
{{ else }}
echo "--> [XRemap] Provider disabled..."
if systemctl --user is-active --quiet "xremap.service" 2>/dev/null; then
    echo "    Retiring user xremap.service..."
    systemctl --user disable --now "xremap.service" 2>/dev/null || true
fi
{{ end }}

# 7. User Services: Hyprland Desktop Services
{{ if $m.features.hyprland }}
echo "--> [Hyprland Daemons] Feature enabled..."
for usvc in "hypridle.service" "mako.service"; do
    if systemctl --user list-unit-files "$usvc" &>/dev/null; then
        if ! systemctl --user is-active --quiet "$usvc"; then
            echo "    Enabling user $usvc..."
            systemctl --user enable "$usvc" 2>/dev/null || true
        fi
    fi
done
{{ else }}
echo "--> [Hyprland Daemons] Feature disabled..."
for usvc in "hypridle.service" "mako.service"; do
    if systemctl --user is-active --quiet "$usvc" 2>/dev/null; then
        echo "    Retiring user $usvc..."
        systemctl --user disable --now "$usvc" 2>/dev/null || true
    fi
done
{{ end }}

echo "=============================================================================="
echo "==> Service and provider reconciliation complete."
echo "=============================================================================="
{{ end }}
