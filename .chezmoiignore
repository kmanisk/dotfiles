# ==============================================================================
# Machine & Feature Resolution (Safe generic fallback)
# ==============================================================================
{{- $machineKey := "" -}}
{{- if hasKey . "machine" -}}
{{-   $machineKey = .machine -}}
{{- else if eq .chezmoi.os "windows" -}}
{{-   $machineKey = "windows-workstation" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $machineKey = "generic-linux" -}}
{{- else -}}
{{-   fail "Unsupported operating system" -}}
{{- end -}}
{{- $m := index .machines $machineKey -}}
{{- if not $m -}}
{{-   fail (printf "Machine profile %q not found in .chezmoidata.toml" $machineKey) -}}
{{- end -}}

