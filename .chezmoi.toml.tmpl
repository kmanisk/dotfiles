encryption = "age"
[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age1shu7a5lx3puszpg9r9e39u2t2a6yl3mvnfezhsulfze8335k9fhslf8x78"

{{- $defaultMachine := "asus-tuf-f16" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $defaultMachine = "windows-workstation" -}}
{{- end -}}
{{- $machine := promptStringOnce . "machine" "Machine identifier (e.g. asus-tuf-f16, windows-workstation, generic-linux)" $defaultMachine -}}
{{- $email := promptStringOnce . "email" "Git email address" "mathewmanisk699@gmail.com" -}}
{{- $name := promptStringOnce . "name" "Git user name" "Kumar Manisk" -}}
{{- $profile := promptChoiceOnce . "profile" "Installation profile (mini/full)" (list "mini" "full") "full" -}}
{{- $isWork := promptBoolOnce . "isWork" "Is this a work machine" false -}}

[data]
    machine = {{ $machine | quote }}
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    profile = {{ $profile | quote }}
    isWork = {{ $isWork }}

[diff]
    exclude = ["scripts"]

[status]
    exclude = ["scripts"]
