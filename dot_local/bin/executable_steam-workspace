#!/bin/sh
# steam-workspace - smart Steam launcher/focuser.
# Not running → spawn on ws3. Already running → move+focus on ws3.
set -u

WS=3

if ! pgrep -x steam >/dev/null 2>&1; then
    nohup steam >/dev/null 2>&1 &
    i3-msg "workspace number $WS" >/dev/null 2>&1
    (sleep 8; i3-msg "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1; sleep 2; i3-msg "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1) &
else
    i3-msg "[instance=\"steamwebhelper\"] focus; workspace number $WS" >/dev/null 2>&1
fi
