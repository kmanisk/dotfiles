#!/usr/bin/env python3
import json
import os
import subprocess
import sys

def run_cmd(cmd, timeout=30):
    try:
        res = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout
        )
        if res.returncode != 0:
            err = res.stderr.strip() or res.stdout.strip() or f"Exit code {res.returncode}"
            return f"Error ({res.returncode}): {err}"
        return res.stdout.strip() if res.stdout.strip() else "(ok)"
    except subprocess.TimeoutExpired:
        return "Error: Command timed out"
    except Exception as e:
        return f"Error: {str(e)}"

def read_message():
    line = sys.stdin.readline()
    if not line:
        return None
    return json.loads(line)

def write_message(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

TOOLS = [
    {
        "name": "matugen_apply_image",
        "description": "Generate and apply a Material You dynamic color theme from a wallpaper/image across all apps (GTK, Qt, Waybar, Hyprland, Kitty, etc.).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "image_path": {"type": "string", "description": "Absolute path to the wallpaper or image"},
                "mode": {"type": "string", "enum": ["dark", "light", "smart"], "default": "dark", "description": "Theme mode"},
                "scheme_type": {
                    "type": "string",
                    "enum": [
                        "scheme-tonal-spot", "scheme-content", "scheme-expressive",
                        "scheme-fidelity", "scheme-fruit-salad", "scheme-monochrome",
                        "scheme-neutral", "scheme-rainbow", "scheme-vibrant", "scheme-smart"
                    ],
                    "default": "scheme-tonal-spot",
                    "description": "Material color scheme variant"
                },
                "contrast": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0, "description": "Contrast adjustment (-1.0 to 1.0)"},
                "source_color_index": {"type": "number", "default": 0, "description": "Color index (0=dominant, 1=secondary, etc.)"},
                "dry_run": {"type": "boolean", "default": False, "description": "Simulate generation without writing files or running hooks"}
            },
            "required": ["image_path"]
        }
    },
    {
        "name": "matugen_apply_color",
        "description": "Generate and apply a Material You theme from a specific HEX color code across all configured desktop templates.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "hex_color": {"type": "string", "description": "Hex color code (e.g. #3b82f6 or 3b82f6)"},
                "mode": {"type": "string", "enum": ["dark", "light", "smart"], "default": "dark", "description": "Theme mode"},
                "scheme_type": {
                    "type": "string",
                    "enum": [
                        "scheme-tonal-spot", "scheme-content", "scheme-expressive",
                        "scheme-fidelity", "scheme-fruit-salad", "scheme-monochrome",
                        "scheme-neutral", "scheme-rainbow", "scheme-vibrant", "scheme-smart"
                    ],
                    "default": "scheme-tonal-spot",
                    "description": "Material color scheme variant"
                },
                "contrast": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.0, "description": "Contrast adjustment (-1.0 to 1.0)"},
                "dry_run": {"type": "boolean", "default": False, "description": "Simulate generation without writing files or running hooks"}
            },
            "required": ["hex_color"]
        }
    },
    {
        "name": "matugen_get_palette_json",
        "description": "Generate complete Material You color palette tokens in JSON format without applying changes to desktop config files.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "source": {"type": "string", "description": "Image path or hex color"},
                "source_type": {"type": "string", "enum": ["image", "color"], "default": "image", "description": "Type of source input"},
                "mode": {"type": "string", "enum": ["dark", "light", "smart"], "default": "dark"},
                "scheme_type": {"type": "string", "default": "scheme-tonal-spot"},
