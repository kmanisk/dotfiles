SCHEMES_INFO = {
    "scheme-tonal-spot": "Standard Material You palette. Balanced saturation and tone distribution, ideal for daily desktop use.",
    "scheme-content": "Preserves the exact chroma and hue of the primary color with minimal tonal shifts.",
    "scheme-expressive": "High energy with vivid accents and contrasting complementary tones.",
    "scheme-fidelity": "Prioritizes high visual accuracy to the source color over algorithmic harmonization.",
    "scheme-fruit-salad": "Playful, colorful palette with diverse hues across containers and accents.",
    "scheme-monochrome": "Strict single-hue grayscale / muted monochrome palette.",
    "scheme-neutral": "Understated, muted palette with very low saturation for minimal distraction.",
    "scheme-rainbow": "High variety across color wheel sectors.",
    "scheme-vibrant": "Maximum punch and saturation for vibrant contrast on OLED / high-gamut displays.",
    "scheme-smart": "Adaptive scheme that evaluates source image characteristics to pick the optimal algorithm."
}

def clean_hex(h):
    h = h.strip()
    if not h.startswith("#"):
        h = "#" + h
    return h

def main():
    while True:
        req = read_message()
        if req is None:
            break
        req_id = req.get("id")
        method = req.get("method")
        
        if method == "initialize":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": {
                        "name": "matugen-mcp",
                        "version": "1.0.0"
                    }
                }
            })
        elif method == "notifications/initialized":
            pass
        elif method == "tools/list":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": TOOLS
                }
            })
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            
            content = ""
            if name == "matugen_apply_image":
                img = os.path.expanduser(args["image_path"])
                mode = args.get("mode", "dark")
                scheme = args.get("scheme_type", "scheme-tonal-spot")
                contrast = str(args.get("contrast", 0.0))
                idx = str(args.get("source_color_index", 0))
                cmd = [
                    "matugen", "image", img,
                    "-m", mode,
                    "-t", scheme,
                    "--contrast", contrast,
                    "--source-color-index", idx
                ]
                if args.get("dry_run"):
                    cmd.append("--dry-run")
                content = run_cmd(cmd, timeout=45)
            elif name == "matugen_apply_color":
                hex_col = clean_hex(args["hex_color"])
                mode = args.get("mode", "dark")
                scheme = args.get("scheme_type", "scheme-tonal-spot")
                contrast = str(args.get("contrast", 0.0))
                cmd = [
                    "matugen", "color", "hex", hex_col,
                    "-m", mode,
                    "-t", scheme,
                    "--contrast", contrast
                ]
                if args.get("dry_run"):
                    cmd.append("--dry-run")
                content = run_cmd(cmd, timeout=45)
            elif name == "matugen_get_palette_json":
                src_type = args.get("source_type", "image")
                src = os.path.expanduser(args["source"])
                mode = args.get("mode", "dark")
                scheme = args.get("scheme_type", "scheme-tonal-spot")
                fmt = args.get("format", "hex")
                if src_type == "color":
                    hex_col = clean_hex(src)
                    cmd = ["matugen", "color", "hex", hex_col, "-m", mode, "-t", scheme, "--dry-run", "--json", fmt]
                else:
                    cmd = ["matugen", "image", src, "-m", mode, "-t", scheme, "--source-color-index", "0", "--dry-run", "--json", fmt]
                content = run_cmd(cmd, timeout=30)
            elif name == "matugen_extract_source_colors":
                img = os.path.expanduser(args["image_path"])
                cmd = ["matugen", "image", img, "--show-source-colors"]
                content = run_cmd(cmd, timeout=15)
            elif name == "matugen_list_schemes":
                content = json.dumps(SCHEMES_INFO, indent=2)
            else:
                content = f"Unknown tool: {name}"

            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [
                        {"type": "text", "text": content}
                    ]
                }
            })
        else:
            if req_id is not None:
                write_message({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method {method} not found"
                    }
                })

if __name__ == "__main__":
    main()
