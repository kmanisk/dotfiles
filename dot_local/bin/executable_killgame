#!/usr/bin/env bash
# ==============================================================================
# Emergency Game / Compositor Termination Script (killgame / kg)
# ==============================================================================
echo "==> Terminating hung game processes and compositors..."

# 1. Kill CS2, Gamescope, and Steam processes
killall -9 -v cs2 gamescope gamescopereaper steam steamwebhelper 2>/dev/null || true
pkill -9 -e -f "gamescope|cs2|steam" 2>/dev/null || true

# 2. Restore display resolution and Polybar
export DISPLAY="${DISPLAY:-:0}"
xrandr --output eDP-1 --set "scaling mode" "Full aspect" 2>/dev/null || true
xrandr --output eDP-1 --mode 1920x1200 --rate 165.00 2>/dev/null || xrandr --output eDP-1 --auto 2>/dev/null || true
sh "$HOME/.fehbg" 2>/dev/null || true
i3-msg restart 2>/dev/null || true
if [ "$(cat "$HOME/.config/polybar/bar_state" 2>/dev/null)" != "hidden" ]; then
    polybar-msg cmd show 2>/dev/null || true
fi

# 3. Guidance message
echo ""
echo "==> Done! Return to your desktop by pressing: Ctrl + Alt + F2 (or Ctrl + Alt + Fn + F2)"
echo "==> If the screen is still black, run: sudo systemctl restart ly@tty2"
