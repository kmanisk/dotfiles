#!/usr/bin/env bash
# ==============================================================================
# CS2 Low-Latency Launcher (Hybrid Optimus Mode)
# - Hardware: ASUS TUF F16 (i5-13450HX + RTX 5050 Laptop)
# - CPU Pinning: taskset -c 0-11 (Physical P-cores only, excluding E-cores 12-15)
# - GPU Offload: NVIDIA PRIME Render Offload on RTX 5050
# - Resolution: Stretched 4:3 1600x1200 -> 1920x1200 @ 165Hz via Gamescope
# - Latency: Immediate flips, gamemoderun, bar suspended during gameplay
# ==============================================================================

# 1. Force dedicated NVIDIA GPU via PRIME Offload (Hybrid Mode)
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

# 2. Suspend status bar polling to eliminate frame-time spikes
trap 'polybar-msg cmd show 2>/dev/null || true' EXIT
polybar-msg cmd hide 2>/dev/null || true

# 3. MangoHud Benchmark Support (Optional)
# If MANGOHUD=1 or ENABLE_MANGOHUD=1 is passed, wrap the game in mangohud inside gamescope.
# Explicitly unset MANGOHUD for gamescope's outer compositor to prevent duplicate/stretched HUD.
if [ "${MANGOHUD:-0}" = "1" ] || [ "${ENABLE_MANGOHUD:-0}" = "1" ]; then
    MANGOHUD_WRAPPER="mangohud"
else
    MANGOHUD_WRAPPER=""
fi

# 4. Game Launch Strategy
# If gamescope is installed and not bypassed: run with immediate flips, cursor grab, and 4:3 stretched scaling
if command -v gamescope >/dev/null 2>&1 && [ "${NO_GAMESCOPE:-0}" != "1" ]; then
    exec env MANGOHUD=0 taskset -c 0-11 gamemoderun gamescope \
      -w 1440 -h 1080 \
      -W 1920 -H 1200 \
      -r 165 -f -S stretch \
      --force-grab-cursor \
      --immediate-flips \
      -- $MANGOHUD_WRAPPER "$@" -novid -nojoy
else
    # Direct native fallback (zero compositor overhead)
    exec taskset -c 0-11 gamemoderun $MANGOHUD_WRAPPER "$@" -novid -nojoy
fi
