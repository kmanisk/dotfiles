#!/usr/bin/env bash
# ==============================================================================
# CS2 Low-Latency Launcher (Hybrid Optimus Mode + Gamescope Stretched 4:3)
# ==============================================================================
# - Hardware: ASUS TUF F16 (i5-13450HX + RTX 5050 Laptop)
# - Gamescope runs on Intel iGPU (drives internal eDP-1 at native 1920x1200 @ 165Hz)
# - CS2 renders on dedicated NVIDIA RTX 5050 via PRIME Offload
# - ENABLE_GAMESCOPE_WSI=0 prevents swapchain crash with -S stretch on NVIDIA 555+/610+
# - CPU Pinning: Physical P-cores 0-11 (Bypasses E-cores to eliminate micro-stutters)
# - Audio: Low-latency PulseAudio streaming (30ms) & SBC-XQ Bluetooth codec
# - Power: ASUS Balanced mode
# ==============================================================================

# 1. Polybar cleanup handler
trap 'polybar-msg cmd show 2>/dev/null || true' EXIT INT TERM
polybar-msg cmd hide 2>/dev/null || true

# 2. Set ASUS power profile to Balanced as requested
asusctl profile set Balanced >/dev/null 2>&1 || true

# 3. Audio latency optimization: stream unbuffered 30ms frames and ensure SBC-XQ codec
export SDL_AUDIO_DRIVER=pulseaudio
export PULSE_LATENCY_MSEC=30
BT_CARD=$(pactl list cards short 2>/dev/null | grep bluez_card | awk '{print $2}' | head -n1)
if [ -n "$BT_CARD" ]; then
    pactl set-card-profile "$BT_CARD" a2dp-sink-sbc_xq 2>/dev/null || true
fi

# 4. MangoHud Overlay Support (MANGOHUD=1)
if [ "${MANGOHUD:-0}" = "1" ] || [ "${ENABLE_MANGOHUD:-0}" = "1" ]; then
    MANGOHUD_WRAPPER="mangohud"
else
    MANGOHUD_WRAPPER=""
fi

# 5. PRIME offload only for the inner game — NOT for gamescope itself
GAME_ENV=(
    env
    __NV_PRIME_RENDER_OFFLOAD=1
    __GLX_VENDOR_LIBRARY_NAME=nvidia
    __VK_LAYER_NV_optimus=NVIDIA_only
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
    MANGOHUD=0
)

# 6. Launch via Gamescope (Stretched 4:3 1440x1080 -> 1920x1200 @ 165Hz)
if command -v gamescope >/dev/null 2>&1; then
    exec env ENABLE_GAMESCOPE_WSI=0 \
      taskset -c 0-11 gamescope \
      -w 1440 -h 1080 \
      -W 1920 -H 1200 \
      -r 165 -f -S stretch \
      --immediate-flips \
      -- gamemoderun "${GAME_ENV[@]}" $MANGOHUD_WRAPPER "$@" -novid -nojoy
else
    exec taskset -c 0-11 gamemoderun "${GAME_ENV[@]}" $MANGOHUD_WRAPPER "$@" -novid -nojoy
fi

