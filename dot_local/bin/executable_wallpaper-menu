#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

options="🎲 Random Wallpaper\n🎮 Gaming Wallpaper\n💀 Creepy & Dark Wallpaper\n🌍 Earth & Nature Wallpaper"
chosen=$(echo -e "$options" | rofi -dmenu -i -p "Wallpaper")

case "$chosen" in
    *"Random"*)
        ~/.local/bin/random-wallpaper random
        ;;
    *"Gaming"*)
        ~/.local/bin/random-wallpaper gaming
        ;;
    *"Creepy"*)
        ~/.local/bin/random-wallpaper creepy
        ;;
    *"Earth"*)
        ~/.local/bin/random-wallpaper earth
        ;;
esac
