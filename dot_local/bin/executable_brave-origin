#!/usr/bin/env bash
# Brave Browser GPU Launcher (forces NVIDIA dedicated GPU with Vulkan ANGLE and 140% UI scale)
BRAVE_BIN=$(command -v /usr/bin/brave-origin || command -v /usr/sbin/brave-origin || command -v /usr/bin/brave || echo "brave")
if command -v prime-run >/dev/null 2>&1; then
    exec prime-run "$BRAVE_BIN" --force-device-scale-factor=1.40 "$@"
else
    exec "$BRAVE_BIN" --force-device-scale-factor=1.40 "$@"
fi
