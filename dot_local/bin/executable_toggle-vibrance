#!/usr/bin/env bash
# ==============================================================================
# Digital Vibrance Controller for i3wm (Picom GLSL Shader)
# Simulates NVIDIA Digital Vibrance / Saturation boost (0% - 100%)
# Usage: toggle-vibrance [toggle | on | off | 0..100]
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:$PATH"

STATE_FILE="/tmp/vibrance_state"
LEVEL_FILE="$HOME/.config/vibrance_level"
SHADER_FILE="$HOME/.config/picom/shaders/vibrance.glsl"

DEFAULT_LEVEL=25
[[ -f "$LEVEL_FILE" ]] && DEFAULT_LEVEL=$(cat "$LEVEL_FILE" 2>/dev/null)

apply_shader() {
    local boost="$1"
    local factor
    factor=$(awk "BEGIN {printf \"%.2f\", $boost / 100}")

    mkdir -p "$HOME/.config/picom/shaders"
    cat << SHADER > "$SHADER_FILE"
#version 330
in vec2 texcoord;

uniform sampler2D tex;

vec4 default_post_processing(vec4 c);

vec4 window_shader() {
    vec2 texsize = textureSize(tex, 0);
    vec4 color = texture(tex, texcoord / texsize);

    // Vibrance factor (${boost}% boost)
    const float vibrance = ${factor};

    // Perceptual luma (Rec. 709)
    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));

    // Calculate saturation spread
    float maxColor = max(color.r, max(color.g, color.b));
    float minColor = min(color.r, min(color.g, color.b));
    float colorSat = maxColor - minColor;

    // Natural vibrance boost
    color.rgb = mix(color.rgb, mix(vec3(luma), color.rgb, 1.0 + vibrance * 1.25), 1.0 - colorSat * 0.35);
    color.rgb = clamp(color.rgb, 0.0, 1.0);

    return default_post_processing(color);
}
SHADER

    pkill -9 picom 2>/dev/null || true
    sleep 0.15
    picom -b --config "$HOME/.config/picom/picom.conf" --window-shader-fg "$SHADER_FILE" >/dev/null 2>&1
}

turn_off() {
    echo "0" > "$STATE_FILE"
    pkill -9 picom 2>/dev/null || true
    sleep 0.15
    picom -b --config "$HOME/.config/picom/picom.conf" >/dev/null 2>&1
    notify-send -h string:x-canonical-private-synchronous:vibrance -t 1500 -i preferences-desktop-display "Digital Vibrance" "Disabled (Normal 0%)"
}

turn_on() {
    local lvl="${1:-$DEFAULT_LEVEL}"
    echo "$lvl" > "$STATE_FILE"
    echo "$lvl" > "$LEVEL_FILE"
    apply_shader "$lvl"
    notify-send -h string:x-canonical-private-synchronous:vibrance -t 1500 -i preferences-desktop-display "Digital Vibrance" "Enabled (+${lvl}% Saturation)"
}

ACTION="${1:-toggle}"

case "$ACTION" in
    off|0)
        turn_off
        ;;
    on)
        turn_on "$DEFAULT_LEVEL"
        ;;
    toggle)
        if [[ -f "$STATE_FILE" ]] && [[ "$(cat "$STATE_FILE")" != "0" ]]; then
            turn_off
        else
            turn_on "$DEFAULT_LEVEL"
        fi
        ;;
    [0-9]*)
        if [[ "$ACTION" -eq 0 ]]; then
            turn_off
        else
            turn_on "$ACTION"
        fi
        ;;
    *)
        turn_on "$DEFAULT_LEVEL"
        ;;
esac
