#!/usr/bin/env bash
# ==============================================================================
# Random Wallpaper Fetcher (Reddit + Wallhaven Dual Engine + Local Cache)
# Categories: Creepy, Gaming, Earth (Strictly No Anime)
# ==============================================================================

export PATH="$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"
WALLPAPER_FILE="$HOME/.config/i3/wallpaper.png"
CACHE_DIR="$HOME/.cache/wallpapers"
TEMP_FILE="/tmp/random_wallpaper_download_$$.png"

mkdir -p "$CACHE_DIR"

CATEGORIES=("creepy" "gaming")
CATEGORY="${1:-}"

# If no category or "random" passed, pick one randomly
if [[ -z "$CATEGORY" || "$CATEGORY" == "random" ]]; then
    CATEGORY="${CATEGORIES[$RANDOM % ${#CATEGORIES[@]}]}"
fi

case "$CATEGORY" in
    creepy)
        SUBREDDITS=("creepy" "ImaginaryMonsters" "DarkGothicArt" "creepyart" "DarkArt" "horror")
        TAGS=("creepy" "dark+fantasy" "horror" "gothic" "monster" "dark")
        DISPLAY_NAME="Creepy & Dark"
        ;;
    gaming)
        SUBREDDITS=("GamingWallpapers" "videogamephotography" "GamerPorn")
        TAGS=("video+games" "gaming" "cyberpunk+2077" "elden+ring" "witcher" "dark+souls" "half-life")
        DISPLAY_NAME="Gaming"
        ;;
    *)
        SUBREDDITS=("GamingWallpapers" "creepy" "DarkGothicArt" "videogamephotography")
        TAGS=("gaming" "dark+fantasy" "cyberpunk+2077" "dark")
        DISPLAY_NAME="Random"
        ;;
esac

WALLHAVEN_TAG="${TAGS[$RANDOM % ${#TAGS[@]}]}"
SELECTED_SUB="${SUBREDDITS[$RANDOM % ${#SUBREDDITS[@]}]}"
IMAGE_URL=""
SOURCE=""

# Immediate notification
command -v notify-send >/dev/null && notify-send -t 2500 -i preferences-desktop-wallpaper "Wallpaper Switcher" "Fetching ${DISPLAY_NAME} wallpaper..."

# ------------------------------------------------------------------------------
# 1. Try Reddit API first
# ------------------------------------------------------------------------------
REDDIT_UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
REDDIT_JSON=$(curl -s -L --max-time 4 -A "$REDDIT_UA" "https://www.reddit.com/r/${SELECTED_SUB}/hot.json?limit=50" 2>/dev/null)

if [[ -n "$REDDIT_JSON" && "$REDDIT_JSON" == *"\"data\""* && "$REDDIT_JSON" != *"Blocked"* ]]; then
    IMAGE_URL=$(echo "$REDDIT_JSON" | jq -r '
        [.data.children[].data | 
        select(.post_hint == "image" or (.url | test("\\.(jpg|jpeg|png)$"))) | 
        select(.preview.images[0].source.width >= 1920 or .preview == null) | 
        .url] | 
        if length > 0 then .[range(0; length)] else empty end' 2>/dev/null | shuf -n 1)

    if [[ -n "$IMAGE_URL" && "$IMAGE_URL" =~ ^https?:// ]]; then
        SOURCE="r/${SELECTED_SUB}"
    fi
fi

# ------------------------------------------------------------------------------
# 2. Wallhaven API (Ultra HD, Non-Anime: categories=100 ensures 0% anime)
# ------------------------------------------------------------------------------
if [[ -z "$IMAGE_URL" ]]; then
    RANDOM_PAGE=$((RANDOM % 5 + 1))
    # categories=100 -> General: 1, Anime: 0, People: 0
    WALLHAVEN_JSON=$(curl -s -L --max-time 6 "https://wallhaven.cc/api/v1/search?q=${WALLHAVEN_TAG}&categories=100&purity=100&atleast=1920x1080&ratios=16x9,16x10&page=${RANDOM_PAGE}" 2>/dev/null)
    if [[ -n "$WALLHAVEN_JSON" ]]; then
        IMAGE_URL=$(echo "$WALLHAVEN_JSON" | jq -r '.data[]?.path' 2>/dev/null | shuf -n 1)
        if [[ -n "$IMAGE_URL" && "$IMAGE_URL" =~ ^https?:// ]]; then
            SOURCE="Wallhaven (${WALLHAVEN_TAG//+/ })"
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 3. Download, Cache, Save & Apply via feh
# ------------------------------------------------------------------------------
MAX_CACHE_FILES=25

if [[ -n "$IMAGE_URL" ]]; then
    if curl -s -L --max-time 15 "$IMAGE_URL" -o "$TEMP_FILE" && file "$TEMP_FILE" | grep -qiE 'image|bitmap'; then
        cp "$TEMP_FILE" "$CACHE_DIR/${CATEGORY}_$(date +%s).jpg"
        mv "$TEMP_FILE" "$WALLPAPER_FILE"
        if [[ -d "$HOME/.local/share/chezmoi/dot_config/i3" ]]; then
            cp -f "$WALLPAPER_FILE" "$HOME/.local/share/chezmoi/dot_config/i3/wallpaper.png" 2>/dev/null || true
        fi
        feh --bg-fill "$WALLPAPER_FILE"
        chmod +x "$HOME/.fehbg" 2>/dev/null || true

        # Prune cache: keep only the newest $MAX_CACHE_FILES images to prevent disk bloat
        find "$CACHE_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.png" \) -printf '%T@ %p\n' 2>/dev/null | \
            sort -rn | tail -n +$((MAX_CACHE_FILES + 1)) | cut -d' ' -f2- | xargs -r rm -f

        command -v notify-send >/dev/null && notify-send -i preferences-desktop-wallpaper "Wallpaper Applied!" "${DISPLAY_NAME}\nSource: ${SOURCE}"
        exit 0
    fi
    rm -f "$TEMP_FILE"
fi

# ------------------------------------------------------------------------------
# 4. Offline / Local Cache Fallback
# ------------------------------------------------------------------------------
CACHED_IMG=$(find "$CACHE_DIR" -type f \( -name "*.jpg" -o -name "*.png" \) 2>/dev/null | shuf -n 1)
if [[ -n "$CACHED_IMG" && -f "$CACHED_IMG" ]]; then
    cp "$CACHED_IMG" "$WALLPAPER_FILE"
    if [[ -d "$HOME/.local/share/chezmoi/dot_config/i3" ]]; then
        cp -f "$WALLPAPER_FILE" "$HOME/.local/share/chezmoi/dot_config/i3/wallpaper.png" 2>/dev/null || true
    fi
    feh --bg-fill "$WALLPAPER_FILE"
    chmod +x "$HOME/.fehbg" 2>/dev/null || true
    command -v notify-send >/dev/null && notify-send -i preferences-desktop-wallpaper "Wallpaper Applied" "Loaded from offline cache (${DISPLAY_NAME})"
    exit 0
fi

command -v notify-send >/dev/null && notify-send -u low -i dialog-warning "Wallpaper" "Could not load wallpaper. Check connection."
exit 1
