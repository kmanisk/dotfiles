#!/usr/bin/env bash
# ==============================================================================
# Random Wallpaper Fetcher (Reddit + Wallhaven Dual Engine + Local Cache)
# Categories: gaming, creepy, creative, nature, minimal
# ==============================================================================

export PATH="$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"
WALLPAPER_FILE="$HOME/.config/i3/wallpaper.png"
CACHE_DIR="$HOME/.cache/wallpapers"
TEMP_FILE="/tmp/random_wallpaper_download_$$.png"

mkdir -p "$CACHE_DIR"

CATEGORIES=("gaming" "creepy" "creative" "nature" "minimal")
CATEGORY="${1:-}"

# If no category or "random" passed, pick one randomly
if [[ -z "$CATEGORY" || "$CATEGORY" == "random" ]]; then
    CATEGORY="${CATEGORIES[$RANDOM % ${#CATEGORIES[@]}]}"
fi

case "$CATEGORY" in
    gaming)
        SUBREDDITS=("GamingWallpapers" "videogamephotography" "GamerPorn")
        TAGS=("gaming" "video+games" "cyberpunk+2077" "elden+ring" "witcher")
        ;;
    creepy)
        SUBREDDITS=("creepy" "ImaginaryMonsters" "DarkGothicArt" "creepyart")
        TAGS=("creepy" "dark+fantasy" "horror" "gothic")
        ;;
    creative)
        SUBREDDITS=("ImaginaryLandscapes" "Cyberpunk" "Moescape" "MinimalWallpaper" "Art")
        TAGS=("cyberpunk" "concept+art" "digital+art" "fantasy+landscape" "sci-fi")
        ;;
    nature)
        SUBREDDITS=("EarthPorn" "spaceporn" "SkyPorn" "ExposurePorn")
        TAGS=("nature" "space" "galaxy" "mountains")
        ;;
    minimal)
        SUBREDDITS=("MinimalWallpaper" "minimalism")
        TAGS=("minimalism" "simple" "abstract")
        ;;
    *)
        SUBREDDITS=("wallpaper" "wallpapers")
        TAGS=("wallpaper" "art")
        ;;
esac

WALLHAVEN_TAG="${TAGS[$RANDOM % ${#TAGS[@]}]}"
SELECTED_SUB="${SUBREDDITS[$RANDOM % ${#SUBREDDITS[@]}]}"
IMAGE_URL=""
SOURCE=""

# Immediate notification so user knows keybind registered
command -v notify-send >/dev/null && notify-send -t 2500 -i preferences-desktop-wallpaper "Wallpaper Switcher" "Fetching ${CATEGORY^} wallpaper..."

# ------------------------------------------------------------------------------
# 1. Try Reddit API first (if accessible)
# ------------------------------------------------------------------------------
REDDIT_UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
REDDIT_JSON=$(curl -s -L --max-time 4 -A "$REDDIT_UA" "https://www.reddit.com/r/${SELECTED_SUB}/hot.json?limit=50" 2>/dev/null)

if [[ -n "$REDDIT_JSON" && "$REDDIT_JSON" == *"\"data\""* && "$REDDIT_JSON" != *"Blocked"* ]]; then
    IMAGE_URL=$(echo "$REDDIT_JSON" | jq -r '
        [.data.children[].data | 
        select(.post_hint == "image" or (.url | test("\\.(jpg|jpeg|png)$"))) | 
        select(.preview.images[0].source.width >= 1920 or .preview == null) | 
        .url] | 
        if length > 0 then .[range(0; length)] else empty end' 2>/dev/null | shuf -n 1)

    if [[ -n "$IMAGE_URL" && "$IMAGE_URL" =~ ^https?:// ]]; then
        SOURCE="r/${SELECTED_SUB}"
    fi
fi

# ------------------------------------------------------------------------------
# 2. Bulletproof Fallback: Wallhaven API (Ultra HD & Curated)
# ------------------------------------------------------------------------------
if [[ -z "$IMAGE_URL" ]]; then
    RANDOM_PAGE=$((RANDOM % 5 + 1))
    WALLHAVEN_JSON=$(curl -s -L --max-time 6 "https://wallhaven.cc/api/v1/search?q=${WALLHAVEN_TAG}&atleast=1920x1080&ratios=16x9,16x10&page=${RANDOM_PAGE}" 2>/dev/null)
    if [[ -n "$WALLHAVEN_JSON" ]]; then
        IMAGE_URL=$(echo "$WALLHAVEN_JSON" | jq -r '.data[]?.path' 2>/dev/null | shuf -n 1)
        if [[ -n "$IMAGE_URL" && "$IMAGE_URL" =~ ^https?:// ]]; then
            SOURCE="Wallhaven (${WALLHAVEN_TAG//+/ })"
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 3. Download, Cache, Save & Apply via feh
# ------------------------------------------------------------------------------
if [[ -n "$IMAGE_URL" ]]; then
    if curl -s -L --max-time 15 "$IMAGE_URL" -o "$TEMP_FILE" && file "$TEMP_FILE" | grep -qiE 'image|bitmap'; then
        cp "$TEMP_FILE" "$CACHE_DIR/$(date +%s).jpg"
        mv "$TEMP_FILE" "$WALLPAPER_FILE"
        feh --bg-fill "$WALLPAPER_FILE"
        command -v notify-send >/dev/null && notify-send -i preferences-desktop-wallpaper "Wallpaper Applied!" "Category: ${CATEGORY^}\nSource: ${SOURCE}"
        exit 0
    fi
    rm -f "$TEMP_FILE"
fi

# ------------------------------------------------------------------------------
# 4. Offline / Local Cache Fallback
# ------------------------------------------------------------------------------
CACHED_IMG=$(find "$CACHE_DIR" -type f -name "*.jpg" -o -name "*.png" 2>/dev/null | shuf -n 1)
if [[ -n "$CACHED_IMG" && -f "$CACHED_IMG" ]]; then
    cp "$CACHED_IMG" "$WALLPAPER_FILE"
    feh --bg-fill "$WALLPAPER_FILE"
    command -v notify-send >/dev/null && notify-send -i preferences-desktop-wallpaper "Wallpaper Applied" "Loaded from offline cache"
    exit 0
fi

command -v notify-send >/dev/null && notify-send -u low -i dialog-warning "Wallpaper" "Could not load wallpaper. Check connection."
exit 1
