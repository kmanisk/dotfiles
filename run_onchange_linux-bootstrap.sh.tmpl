{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# ==============================================================================
# Chezmoi Linux Automated Bootstrap Script
# Ensures 100% reproducible state on any Arch Linux / CachyOS machine
# ==============================================================================
set -e

echo "==> [Chezmoi Bootstrap] Running Linux system setup..."

# Check sudo access (interactive vs non-interactive)
HAS_SUDO=0
if sudo -n true 2>/dev/null; then
    HAS_SUDO=1
elif [ -t 0 ] && [ -z "$NONINTERACTIVE" ]; then
    if sudo -v 2>/dev/null; then
        HAS_SUDO=1
    fi
fi

# 1. Native Pacman Packages
NATIVE_PKGS=(
    # Window Manager & Desktop
    i3-wm
    i3lock-color
    i3status
    i3blocks
    picom
    polybar
    alacritty
    rofi
    dunst
    feh
    thunar

    # Shell & CLI Utilities
    fish
    fzf
    bat
    jq
    fastfetch
    starship
    zoxide
    lsd
    neovim

    # Audio & Bluetooth
    pipewire
    pipewire-pulse
    pipewire-alsa
    pipewire-audio
    wireplumber
    pavucontrol
    blueman
    bluez
    bluez-utils

    # System & X11 Utilities
    brightnessctl
    redshift
    maim
    slop
    wl-clipboard
    xclip
    xsel
    xdotool
    xorg-xrandr
    xorg-xrdb
    networkmanager

    # Python & Virtualenv
    python
    python-pip
    python-virtualenv

    # Gaming & Performance
    steam
    gamemode
    gamescope
    mangohud
    power-profiles-daemon

    # Fonts
    ttf-iosevka-nerd
    ttf-font-awesome
    noto-fonts
    noto-fonts-emoji
)

# 2. AUR Packages
AUR_PKGS=(
    asusctl-x11
    tmog-appimage
    brave-origin-bin
    xremap-x11-bin
)

if [ "$HAS_SUDO" -eq 1 ] && command -v pacman >/dev/null 2>&1; then
    # Ensure AUR helper (paru) exists
    if ! command -v paru >/dev/null 2>&1; then
        echo "==> Installing paru-bin (AUR helper)..."
        TMP_DIR=$(mktemp -d)
        sudo pacman -S --needed --noconfirm git base-devel
        git clone https://aur.archlinux.org/paru-bin.git "$TMP_DIR/paru-bin"
        (cd "$TMP_DIR/paru-bin" && makepkg -si --noconfirm)
        rm -rf "$TMP_DIR"
    fi

    echo "==> Checking and installing native packages..."
    sudo pacman -S --needed --noconfirm "${NATIVE_PKGS[@]}" 2>/dev/null || true

    if command -v paru >/dev/null 2>&1; then
        echo "==> Checking and installing AUR packages..."
        paru -S --needed --noconfirm "${AUR_PKGS[@]}" 2>/dev/null || true
    fi

    # User Groups Configuration
    for grp in gamemode video audio input storage rfkill; do
        if getent group "$grp" >/dev/null 2>&1; then
            sudo usermod -aG "$grp" "$USER" 2>/dev/null || true
        fi
    done

    # CS2 & Gaming Performance Sysctl Tweaks (vm.max_map_count)
    if [ -d /etc/sysctl.d ]; then
        if [ ! -f /etc/sysctl.d/99-cs2-gaming.conf ]; then
            echo "==> Configuring CS2 gaming sysctl parameters (vm.max_map_count)..."
            sudo tee /etc/sysctl.d/99-cs2-gaming.conf >/dev/null << 'SYSCTL'
vm.max_map_count = 1048576
fs.file-max = 2097152
vm.swappiness = 100
vm.vfs_cache_pressure = 50
SYSCTL
            sudo sysctl --system >/dev/null 2>&1 || true
        fi
    fi

    # System Services
    echo "==> Enabling essential system services..."
    sudo systemctl enable --now bluetooth.service NetworkManager.service 2>/dev/null || true
    if systemctl list-unit-files 2>/dev/null | grep -q "asusd.service"; then
        sudo systemctl enable --now asusd.service 2>/dev/null || true
    fi
    if systemctl list-unit-files 2>/dev/null | grep -q "nvidia-powerd.service"; then
        sudo systemctl enable --now nvidia-powerd.service 2>/dev/null || true
    fi
    if systemctl list-unit-files 2>/dev/null | grep -q "ananicy-cpp.service"; then
        sudo systemctl enable --now ananicy-cpp.service 2>/dev/null || true
    fi
else
    echo "==> Note: Sudo session not cached; run in your terminal to install system packages and root configs."
fi

# 3. Setup Python Virtual Environment for i3-resurrect & autotiling
VENV_DIR="$HOME/.local/share/i3-resurrect-venv"
if [ ! -f "$VENV_DIR/bin/i3-resurrect" ]; then
    echo "==> Setting up i3-resurrect & autotiling Python virtual environment..."
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --upgrade pip --quiet
    "$VENV_DIR/bin/pip" install i3-resurrect autotiling --quiet
fi
mkdir -p "$HOME/.local/bin"
ln -sf "$VENV_DIR/bin/i3-resurrect" "$HOME/.local/bin/i3-resurrect"
ln -sf "$VENV_DIR/bin/autotiling" "$HOME/.local/bin/autotiling"

# 4. Install Zed Editor if missing
if [ ! -x "$HOME/.local/zed.app/bin/zed" ] && ! command -v zed >/dev/null 2>&1; then
    echo "==> Installing Zed Editor..."
    curl -f https://zed.dev/install.sh | sh
fi

# 5. ASUS Laptop Hardware Controls (battery limit 60%, static red RGB, balanced profile)
if command -v asusctl >/dev/null 2>&1; then
    echo "==> Applying ASUS TUF hardware tuning (60% battery care, static red aura)..."
    asusctl battery limit 60 2>/dev/null || true
    asusctl aura effect static -c a60000 2>/dev/null || true
    asusctl profile set Balanced 2>/dev/null || true
fi

# 6. Enable Systemd User Services
echo "==> Enabling systemd user services..."
systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable --now bt-auto-trust.service i3-session-save.service nightlight-auto.timer 2>/dev/null || true

echo "==> [Chezmoi Bootstrap] Complete! Machine state fully synchronized."
{{ end -}}
