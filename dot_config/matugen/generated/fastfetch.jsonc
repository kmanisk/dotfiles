{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/manisk/.config/fastfetch/custom_ascii.txt",
        "padding": {
            "top": 1,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " \u001b[38;2;141;145;153m󰇙\u001b[0m ",
        "color": {
            "output": "38;2;225;226;232"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;163;201;254m{user-name}\u001b[0m \u001b[38;2;141;145;153m@\u001b[0m \u001b[38;2;187;199;219m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;163;201;254m \u001b[38;2;195;198;207mos\u001b[0m",
            "keyWidth": 14,
            "format": "{2} {8}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;163;201;254m \u001b[38;2;195;198;207mkernel\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;163;201;254m󰦚 \u001b[38;2;195;198;207minstall\u001b[0m",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;163;201;254m󰏖 \u001b[38;2;195;198;207mpkgs\u001b[0m",
            "keyWidth": 14
        },
        {
            "type": "localip",
            "key": "\u001b[38;2;163;201;254m󰩟 \u001b[38;2;195;198;207mip\u001b[0m",
            "keyWidth": 14,
            "format": "{ipv4}",
            "showPrefixLen": false
        },
        "break",
        {
            "type": "wm",
            "key": "\u001b[38;2;187;199;219m󰈹 \u001b[38;2;195;198;207mwm\u001b[0m",
            "keyWidth": 14,
            "format": "{1} ({3})"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;187;199;219m󰒉 \u001b[38;2;195;198;207mshell\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;187;199;219m \u001b[38;2;195;198;207mterm\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;187;199;219m󰹍 \u001b[38;2;195;198;207mdisplay\u001b[0m",
            "keyWidth": 14,
            "format": "{4}x{5} @ {3}Hz"
        },
        "break",
        {
            "type": "cpu",
            "key": "\u001b[38;2;216;189;227m󰍛 \u001b[38;2;195;198;207mcpu\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;216;189;227m󰆧 \u001b[38;2;195;198;207march\u001b[0m",
            "keyWidth": 14,
            "text": "/lib/ld-linux-x86-64.so.2 --help | awk '/supported, searched/ {print $1; exit}'"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;216;189;227m󰢮 \u001b[38;2;195;198;207mgpu\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;216;189;227m󰉿 \u001b[38;2;195;198;207mmemory\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;216;189;227m󰉋 \u001b[38;2;195;198;207mdisk\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3}) - {9}",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
