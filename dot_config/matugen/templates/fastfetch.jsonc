{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/manisk/.config/fastfetch/custom_ascii.txt",
        "padding": {
            "top": 1,
            "right": 3,
            "left": 2
        }
    },
    "display": {
        "separator": " \u001b[38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}m󰇙\u001b[0m ",
        "color": {
            "output": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m{user-name}\u001b[0m \u001b[38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}m@\u001b[0m \u001b[38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m{host-name}\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mos\u001b[0m",
            "keyWidth": 14,
            "format": "{2} {8}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mkernel\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m󰦚 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}minstall\u001b[0m",
            "keyWidth": 14,
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m󰏖 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mpkgs\u001b[0m",
            "keyWidth": 14
        },
        {
            "type": "localip",
            "key": "\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m󰩟 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mip\u001b[0m",
            "keyWidth": 14,
            "format": "{ipv4}",
            "showPrefixLen": false
        },
        "break",
        {
            "type": "wm",
            "key": "\u001b[38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m󰈹 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mwm\u001b[0m",
            "keyWidth": 14,
            "format": "{1} ({3})"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m󰒉 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mshell\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mterm\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "display",
            "key": "\u001b[38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}m󰹍 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mdisplay\u001b[0m",
            "keyWidth": 14,
            "format": "{4}x{5} @ {3}Hz"
        },
        "break",
        {
            "type": "cpu",
            "key": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m󰍛 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mcpu\u001b[0m",
            "keyWidth": 14,
            "format": "{1}"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m󰆧 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}march\u001b[0m",
            "keyWidth": 14,
            "text": "/lib/ld-linux-x86-64.so.2 --help | awk '/supported, searched/ {print $1; exit}'"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m󰢮 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mgpu\u001b[0m",
            "keyWidth": 14,
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m󰉿 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mmemory\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}m󰉋 \u001b[38;2;{{colors.on_surface_variant.default.red}};{{colors.on_surface_variant.default.green}};{{colors.on_surface_variant.default.blue}}mdisk\u001b[0m",
            "keyWidth": 14,
            "format": "{1} / {2} ({3}) - {9}",
            "folders": "/"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
