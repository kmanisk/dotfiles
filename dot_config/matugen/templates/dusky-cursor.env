# Dusky Cursor colors - generated by matugen. Do not edit.
# Consumed by $HOME/user_scripts/cursor/color/dusky_cursor.py on every theme switch.
# NOTE: this file is *parsed*, never sourced. Do not add DUSKY_CURSOR_SOURCE here:
# that variable name is the script's process-env override for the *source theme
# name* (default Bibata-Modern-Classic); writing the wallpaper path into it would
# make any shell that sources this file break the build.
DUSKY_CURSOR_ACCENT={{ colors.primary.default.hex }}
DUSKY_CURSOR_BACKGROUND={{ colors.background.default.hex }}
