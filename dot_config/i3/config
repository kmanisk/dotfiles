set $mod Mod4
font pango:Iosevka Nerd Font 13
floating_modifier $mod

# ==============================================================================
# TERMINAL & APPLICATION LAUNCHERS
# ==============================================================================
set $term alacritty
bindsym Mod1+Return exec $term
# App Launcher (Rofi)
bindsym Mod1+space exec "pkill rofi || rofi -show drun"

# Browser
bindsym Mod1+b exec brave-origin

# Text Editor
bindsym Mod1+Shift+t exec $term -e nvim

# File Manager
bindsym $mod+e exec thunar

# Spotify
bindsym Mod1+m exec spotify

# Task Manager (TMOG in floating window)
bindsym Control+Shift+Escape exec --no-startup-id /usr/bin/TaskManagerOG

# ==============================================================================
# SYSTEM UTILITIES
# ==============================================================================
bindsym Mod1+1 exec $term --class nmtui -e nmtui
# Interactive region screenshot to clipboard (Alt + Shift + 1)
bindsym Mod1+Shift+1 exec --no-startup-id /home/manisk/.local/bin/screenshot-region
bindsym Mod1+2 exec blueman-manager
bindsym Mod1+3 exec pavucontrol
bindsym Mod1+n exec pamixer -t
# Audio Output Switcher between Laptop Speakers and Bluetooth (Alt + Shift + p)
bindsym Mod1+Shift+p exec --no-startup-id /home/manisk/.local/bin/toggle-audio-sink
# Night Light Toggle (Alt + Shift + n)
bindsym Mod1+Shift+n exec --no-startup-id /home/manisk/.local/bin/toggle-nightlight
# Night Light Temperature Slider (Alt + Shift + [ / ')
bindsym Mod1+Shift+bracketleft exec --no-startup-id /home/manisk/.local/bin/adjust-nightlight +250
bindsym Mod1+Shift+apostrophe exec --no-startup-id /home/manisk/.local/bin/adjust-nightlight -250

# Screen Lock (Super + l)
bindsym $mod+l exec "sleep 0.1 && i3lock --blur 5"

# ==============================================================================
# WINDOW MANAGEMENT
# ==============================================================================
# Kill / Close window
bindsym Mod1+q kill

# Smart Layout Toggle: Toggle between Tiling and Stacking (groups existing windows or prepares single window)
bindsym $mod+a exec --no-startup-id ~/.local/bin/smart-layout-toggle
bindsym $mod+f fullscreen toggle
bindsym Mod1+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+a focus parent

# Split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# ==============================================================================
# FOCUS MOVEMENT (hjkl & Arrows)
# ==============================================================================
# ALT + hjkl for focus (from Hyprland config)
bindsym Mod1+h focus left
bindsym Mod1+j focus down
bindsym Mod1+k focus up
bindsym Mod1+l focus right

# Move between tabs (Alt + Shift + j / k)
bindsym Mod1+Shift+j focus next
bindsym Mod1+Shift+k focus prev

# ==============================================================================
# WINDOW MOVEMENT (Control + Shift + hjkl)
# ==============================================================================
bindsym Control+Shift+h move left
bindsym Control+Shift+j move down
bindsym Control+Shift+k move up
bindsym Control+Shift+l move right

# ==============================================================================
# WINDOW RESIZING (Mod + Arrows)
# ==============================================================================

bindsym $mod+Right resize grow width 30 px or 3 ppt
bindsym $mod+Left resize shrink width 30 px or 3 ppt
bindsym $mod+Up resize shrink height 30 px or 3 ppt
bindsym $mod+Down resize grow height 30 px or 3 ppt

# Modal resize
mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+m mode "resize"

# ==============================================================================
# WORKSPACE MANAGEMENT
# ==============================================================================
# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Home-row Workspace Switching (ALT + a/s/d/f/g)
bindsym Mod1+a workspace number $ws1
bindsym Mod1+s workspace number $ws2
bindsym Mod1+d workspace number $ws3
bindsym Mod1+f workspace number $ws4
bindsym Mod1+g workspace number $ws5

# Home-row Move Window (ALT + Shift + a/s/d/f/g)
bindsym Mod1+Shift+a move container to workspace number $ws1
bindsym Mod1+Shift+s move container to workspace number $ws2
bindsym Mod1+Shift+d move container to workspace number $ws3
bindsym Mod1+Shift+f move container to workspace number $ws4
bindsym Mod1+Shift+g move container to workspace number $ws5

# Standard Number Workspace Switching ($mod + 1..0)
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Standard Number Move Window ($mod + Shift + 1..0)
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Sequential Workspace Navigation (Bracket keys)
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next
bindsym $mod+Shift+bracketleft move container to workspace prev; workspace prev
bindsym $mod+Shift+bracketright move container to workspace next; workspace next

# Back and Forth with last workspace
bindsym $mod+Tab workspace back_and_forth

# Scratchpad
# Alt + Shift + z : Move focused window into scratchpad
# Alt + z         : Show / toggle scratchpad window
bindsym Mod1+Shift+z move scratchpad
bindsym Mod1+z scratchpad show

# ==============================================================================
# SESSION & CONFIG RELOAD (with i3-resurrect session manager)
# ==============================================================================
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Safe session save / restore (Alt + Shift + Numbers):
# Alt + Shift + 7 : Save all active workspaces session
# Alt + Shift + 8 : Restore all workspaces session
# Alt + Shift + 9 : Session Manager interactive menu
bindsym Mod1+Shift+7 exec --no-startup-id ~/.local/bin/i3-session-save --all
bindsym Mod1+Shift+8 exec --no-startup-id ~/.local/bin/i3-session-restore --all
bindsym Mod1+Shift+9 exec --no-startup-id ~/.local/bin/i3-session-menu

# Per-workspace quick save / restore (Alt + Ctrl + Numbers):
bindsym Mod1+Control+7 exec --no-startup-id ~/.local/bin/i3-session-save
bindsym Mod1+Control+8 exec --no-startup-id ~/.local/bin/i3-session-restore

# Power / Shutdown Menu:
bindsym Mod1+Escape exec --no-startup-id ~/.local/bin/powermenu


