bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

# Screen Brightness (Hardware keys & on-screen slider)
bindsym XF86MonBrightnessUp exec --no-startup-id /home/manisk/.local/bin/change-brightness +5%
bindsym XF86MonBrightnessDown exec --no-startup-id /home/manisk/.local/bin/change-brightness 5%-
bindsym Mod1+Control+Up exec --no-startup-id /home/manisk/.local/bin/change-brightness +5%
bindsym Mod1+Control+Down exec --no-startup-id /home/manisk/.local/bin/change-brightness 5%-

