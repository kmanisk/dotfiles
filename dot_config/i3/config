for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [class="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [class="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [class="zenity"] floating enable
for_window [class="cachyos-welcome"] floating enable
for_window [class="(?i)^nvidia-settings$"] floating enable, move position center
for_window [class="(?i)^btop$"] floating enable, resize set 1150 720
for_window [class="(?i)^Task Manager TMOG$"] floating enable, resize set 1200 750, move position center
for_window [instance="(?i)^AppRun\.wrapped$"] floating enable, resize set 1200 750, move position center
for_window [instance="(?i)^pkg-float$"] floating enable, resize set 1250 780, move position center

# ==============================================================================
# Steam & Gaming Rules (Dedicated Workspace + Floating Popups)
# Prevents Steam from ever covering running windows or stealing focus on launch
# ==============================================================================
# Send all Steam windows to dedicated Gaming Workspace (Workspace 5: Alt + g)
assign [class="(?i)^steam$"] workspace number $ws5
for_window [class="(?i)^steam$"] move to workspace number $ws5
no_focus [class="(?i)^steam$"]

# Window layout configuration:
# 1. Main Steam library window opens tiled (fills entire workspace)
for_window [class="(?i)^steam$" title="^Steam$"] floating disable
# 2. All Steam dialogs, friends list, chat, news, updater, and settings float
for_window [class="(?i)^steam$" title="^Friends List$"] floating enable, resize set 320 700
for_window [class="(?i)^steam$" title=".* - Chat$"] floating enable
for_window [class="(?i)^steam$" title="^Settings$"] floating enable
for_window [class="(?i)^steam$" title="^Steam - News.*"] floating enable
for_window [class="(?i)^steam$" title="^Screenshot Uploader$"] floating enable
for_window [class="(?i)^steam$" title="^Steam Guard.*"] floating enable, move position center
for_window [class="(?i)^steam$" title="^Sign in to Steam$"] floating enable, move position center
for_window [class="(?i)^steam$" window_role="pop-up"] floating enable

# Game window rules (Always launch CS2, Gamescope, and Steam games in Gaming Workspace 5: Alt + g)
assign [class="(?i)^(cs2|gamescope)$"] workspace number $ws5
assign [class="^steam_app_.*"] workspace number $ws5
for_window [class="(?i)^(cs2|gamescope)$"] move to workspace number $ws5, workspace number $ws5, floating enable, border none, fullscreen enable
for_window [class="^steam_app_.*"] move to workspace number $ws5, workspace number $ws5, floating enable, border none, fullscreen enable
for_window [window_role="pop-up"] floating enable
focus_on_window_activation smart


